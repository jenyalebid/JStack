#!/usr/bin/env python3
"""
pict — Prompt Injection Checking Tool
=====================================

Renders EVERYTHING that would be injected into a Claude Code session spawned
from a given directory, as ONE markdown document, in the order the model
receives it. The composed view — not the per-file view — is where redundancy,
drift, and bloat across a walk-up chain become visible.

Contract:  pict [dir] [options]          (default dir: cwd; markdown on stdout)

Options — describe the spawn being previewed:

  --headless        preview a headless spawn (`claude --print`): interactive-
                    only injectors go quiet (same as PICT_INTERACTIVE=0)
  --no-memory       the spawn env sets CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 —
                    the auto-memory index never loads
  --append FILE     content the spawner passes via --append-system-prompt,
                    in the order given (repeatable)
  --prompt TEXT     the -p payload. A `/command` prompt is resolved the way
                    the harness resolves it (nearest `.claude/commands/` on
                    the walk-up from the spawn dir, then <claude_dir>/commands)
                    and its full body inlined at its true position — the
                    expansion IS the first user message.
  --serve FILE      a captured tool-served payload (a context blob some tool
                    returned mid-session); rendered at the tail of the
                    injection order (repeatable)
  --exec-hooks      actually RUN SessionStart hooks — user settings + every
                    installed plugin — and render what each one injects.
                    OFF by default: hook commands are arbitrary programs.
                    The JStack timeline injector is never re-run (its output
                    is already emulated read-only below).
  --request FILE    render a CAPTURED API request body (the JSON POSTed to
                    /v1/messages) instead of emulating: every system block,
                    tool schema, and message part, verbatim, in wire order,
                    each attributed to the file (or binary/flag/hook) it
                    loads from — the walk-up block breaks down per file,
                    with symlink wiring resolved. This is the byte-truth
                    mode — emulation cannot see the base system prompt or
                    tool schemas; a capture can.

Stages, in wire order (verified against captured request bodies):

  1. System prompt         — the harness-internal base prompt (named, not
                             renderable by emulation) with any --append
                             content inside it.
  2. First user message,   — <claude_dir>/CLAUDE.md, unconditional rules
     project context         (no `paths:` frontmatter), the CLAUDE.md /
                             CLAUDE.local.md walk-up (parent-most first,
                             HTML comments stripped in flight), the
                             auto-memory index (unless --no-memory) —
                             all inside a <system-reminder> in the first
                             user message, NOT the system prompt.
  3. First user message,   — the --prompt payload; /commands expanded to
     command expansion       their full body with $ARGUMENTS / $1..$n
                             substituted, exactly as the harness does.
  4. After the first       — SessionStart hook context + harness
     message                 reminders. The JStack timeline injection is
                             emulated faithfully (same seat resolution +
                             config as hooks/session-start-inject.py).
                             Other hooks are LISTED unless --exec-hooks
                             runs them.
  5. Mid-session data      — --serve captures, in order given.

Then the on-demand layer: path-scoped rules whose `paths:` globs match a
file that EXISTS under the spawn dir right now (JStack tail-matching
semantics), bodies included — these inject on demand, NEVER at spawn.
Rules with no matching files are listed by name only. Finally every
remaining hook from user settings and all installed plugins, one line each.

Out of scope (native harness, not file composition): the base system prompt,
tool/MCP schemas, the skills/commands description list, session guidance.

A summary table with per-source ~token weights (bytes/4) heads the document.
Every body is fenced by unmistakable BEGIN/END banners — where one file ends
and the next begins is the point.

Env overrides (tests; same convention as inject-path-rules.py):
  JSTACK_RULES_DIR      — rules source dir        (default <claude_dir>/rules)
  JSTACK_REVIEW_CONFIG  — review/timeline config  (default <claude_dir>/jstack/review.json)
  PICT_CLAUDE_DIR       — the ~/.claude dir       (default ~/.claude)
  PICT_WALK_ROOT        — upper bound of the walk-up (default /)
  PICT_LOG_EVENT        — log_event binary        (default sibling of pict)
  PICT_INTERACTIVE      — "0" to preview a headless spawn (default interactive)

Exit 0 with the document on stdout; exit 64 on usage error. Stdlib only.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

PLUGIN_BIN = Path(__file__).resolve().parent


def claude_dir() -> Path:
    return Path(os.environ.get("PICT_CLAUDE_DIR", str(Path.home() / ".claude"))).expanduser()


def rules_dir() -> Path:
    override = os.environ.get("JSTACK_RULES_DIR")
    return Path(override).expanduser() if override else claude_dir() / "rules"


def walk_root() -> Path:
    return Path(os.environ.get("PICT_WALK_ROOT", "/")).expanduser()


# ---------------------------------------------------------------- frontmatter

def parse_paths_frontmatter(text: str) -> list[str]:
    """`paths:` globs from YAML frontmatter — same accepted shapes as
    hooks/inject-path-rules.py (block list and inline list)."""
    if not text.startswith("---"):
        return []
    end = text.find("\n---", 3)
    if end == -1:
        return []
    block = text[3:end].lstrip("\n")
    paths: list[str] = []
    in_paths = False
    for raw in block.splitlines():
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if not raw.startswith(" ") and not raw.startswith("\t"):
            if stripped.startswith("paths:"):
                rest = stripped[len("paths:"):].strip()
                if rest.startswith("[") and rest.endswith("]"):
                    paths.extend(
                        v.strip().strip('"').strip("'")
                        for v in rest[1:-1].split(",") if v.strip()
                    )
                    in_paths = False
                else:
                    in_paths = True
                continue
            in_paths = False
            continue
        if in_paths and stripped.startswith("- "):
            val = stripped[2:].strip().strip('"').strip("'")
            if val:
                paths.append(val)
    return paths


def strip_frontmatter(text: str) -> str:
    if not text.startswith("---"):
        return text
    end = text.find("\n---", 3)
    if end == -1:
        return text
    return text[end + 4:].lstrip("\n")


# ------------------------------------------------------------- glob anchoring

def _glob_to_regex(glob: str) -> str:
    """Same translation as inject-path-rules.py — ** crosses segments,
    * and ? stay within one."""
    out = ["^"]
    i, n = 0, len(glob)
    while i < n:
        c = glob[i]
        if c == "*":
            if i + 1 < n and glob[i + 1] == "*":
                if i + 2 < n and glob[i + 2] == "/":
                    out.append("(?:.*/)?")
                    i += 3
                    continue
                out.append(".*")
                i += 2
                continue
            out.append("[^/]*")
            i += 1
            continue
        if c == "?":
            out.append("[^/]")
            i += 1
            continue
        if c in r".+()[]{}|\^$":
            out.append("\\" + c)
            i += 1
            continue
        out.append(c)
        i += 1
    out.append("$")
    return "".join(out)


def _tail_match(rx: re.Pattern, path: str) -> bool:
    """Full path, then every path tail — inject-path-rules semantics."""
    if rx.match(path):
        return True
    parts = path.split("/")
    return any(rx.match("/".join(parts[i:])) for i in range(1, len(parts)))


SCAN_PRUNE = {".git", "node_modules", ".venv", "__pycache__", ".build", "DerivedData"}
SCAN_CAP = 50_000


def anchored_rules(rule_globs: dict[str, list[str]], directory: Path) -> set[str]:
    """Rule stems whose globs match a file that EXISTS under `directory` right
    now. Existence-based on purpose: a `**/*.swift` rule is not 'anchored' to
    a directory that contains no Swift — it would never fire in a session
    working there. One pruned walk, all rules tested per file, each rule
    retired on first hit."""
    pending: dict[str, list[re.Pattern]] = {}
    for stem, globs in rule_globs.items():
        rxs = []
        for g in globs:
            try:
                rxs.append(re.compile(_glob_to_regex(g)))
            except re.error:
                continue
        if rxs:
            pending[stem] = rxs
    hit: set[str] = set()
    seen = 0
    for base, dirs, files in os.walk(directory):
        dirs[:] = [d for d in dirs if d not in SCAN_PRUNE]
        for f in files:
            seen += 1
            if seen > SCAN_CAP or not pending:
                return hit
            path = os.path.join(base, f)
            for stem in list(pending):
                if any(_tail_match(rx, path) for rx in pending[stem]):
                    hit.add(stem)
                    del pending[stem]
    return hit


# ------------------------------------------------------------------ gathering

def tokens(text: str) -> int:
    return max(1, len(text.encode()) // 4)


STAGES = {
    "system": "Stage 1 — system prompt (base prompt + --append-system-prompt)",
    "context": "Stage 2 — first user message · project-context <system-reminder> "
               "(walk-up, rules, memory)",
    "prompt": "Stage 3 — first user message · command expansion",
    "start": "Stage 4 — after the first message · SessionStart hook context",
    "served": "Stage 5 — mid-session tool results (captured)",
}

HTML_COMMENT = re.compile(r"\n*<!--.*?-->", re.S)


class Source:
    def __init__(self, order: int, stage: str, label: str, mechanism: str,
                 body: str | None, note: str = ""):
        self.order = order
        self.stage = stage
        self.label = label
        self.mechanism = mechanism
        self.body = body
        self.note = note


def display(path: Path) -> str:
    home = str(Path.home())
    s = str(path)
    return "~" + s[len(home):] if s.startswith(home) else s


def read_or_none(path: Path) -> str | None:
    try:
        return path.read_text()
    except OSError:
        return None


def add(sources: list[Source], stage: str, label: str, mechanism: str,
        body: str | None, note: str = "") -> None:
    sources.append(Source(len(sources) + 1, stage, label, mechanism, body, note))


def strip_html_comments(body: str) -> tuple[str, int]:
    """The harness deletes HTML comments from CLAUDE.md content in flight
    (verified against a captured request body). Returns (stripped, removed)."""
    stripped = HTML_COMMENT.sub("", body)
    return stripped, len(body) - len(stripped)


def gather_base_note(sources: list[Source]) -> None:
    add(sources, "system", "(base system prompt + tool schemas)",
        "harness-internal — not files; emulation cannot render them. "
        "Capture a request and use --request for the bytes", None)


def gather_globals(sources: list[Source]) -> None:
    gmd = claude_dir() / "CLAUDE.md"
    body = read_or_none(gmd)
    if body is not None:
        body, removed = strip_html_comments(body)
        add(sources, "context", display(gmd),
            "global memory — rides the first-message <system-reminder>", body,
            f"harness strips HTML comments (−{removed} chars)" if removed else "")
    rdir = rules_dir()
    if not rdir.is_dir():
        return
    for rule in sorted(rdir.glob("*.md")):
        text = read_or_none(rule)
        if text is None or parse_paths_frontmatter(text):
            continue
        note = ""
        if rule.is_symlink():
            note = f"symlink → {display(rule.resolve())}"
        add(sources, "context", display(rule),
            "unconditional rule (no `paths:`) — rides the first-message "
            "<system-reminder>", strip_frontmatter(text), note)


def gather_walkup(directory: Path, sources: list[Source]) -> None:
    stop = walk_root().resolve()
    chain = [directory] + list(directory.parents)
    chain = [p for p in chain if str(p).startswith(str(stop))]
    for level in reversed(chain):
        for name in ("CLAUDE.md", "CLAUDE.local.md"):
            f = level / name
            body = read_or_none(f)
            if body is not None:
                body, removed = strip_html_comments(body)
                add(sources, "context", display(f),
                    "CLAUDE.md walk-up — rides the first-message "
                    "<system-reminder>", body,
                    f"harness strips HTML comments (−{removed} chars)"
                    if removed else "")


def project_key(directory: Path) -> str:
    try:
        r = subprocess.run(["git", "-C", str(directory), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, timeout=5)
        root = r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else str(directory)
    except (OSError, subprocess.SubprocessError):
        root = str(directory)
    return re.sub(r"[^A-Za-z0-9]", "-", root)


def gather_memory(directory: Path, sources: list[Source], no_memory: bool) -> None:
    key = project_key(directory)
    if no_memory:
        add(sources, "context", f"(auto-memory DISABLED) key `{key}`",
            "spawn env sets CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 — the index never loads",
            None)
        return
    mem = claude_dir() / "projects" / key / "memory" / "MEMORY.md"
    body = read_or_none(mem)
    if body is not None:
        add(sources, "context", display(mem),
            f"auto-memory index — project key `{key}` — rides the "
            "first-message <system-reminder>", body)
    else:
        add(sources, "context", f"(no auto-memory) key `{key}`",
            "auto-memory index — none recorded for this project key", None)


def gather_appends(appends: list[Path], sources: list[Source]) -> None:
    for f in appends:
        body = read_or_none(f)
        note = f"symlink → {display(f.resolve())}" if f.is_symlink() else ""
        if body is None:
            add(sources, "system", display(f),
                "--append-system-prompt — FILE UNREADABLE", None, note)
        else:
            add(sources, "system", display(f),
                "--append-system-prompt — the spawner injects this inside the "
                "system prompt, ahead of the whole first message", body, note)


# ----------------------------------------------------------------- hook infra

class Hook:
    def __init__(self, origin: str, event: str, matcher: str, command: str,
                 plugin_root: Path | None):
        self.origin = origin
        self.event = event
        self.matcher = matcher
        self.command = command
        self.plugin_root = plugin_root
        self.executed = False


def _hooks_from_json(origin: str, path: Path, plugin_root: Path | None,
                     out: list[Hook]) -> None:
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError, ValueError):
        return
    hooks = data.get("hooks", {})
    if not isinstance(hooks, dict):
        return
    for event, groups in hooks.items():
        if not isinstance(groups, list):
            continue
        for group in groups:
            matcher = group.get("matcher", "*") if isinstance(group, dict) else "*"
            for h in (group.get("hooks") or []) if isinstance(group, dict) else []:
                cmd = h.get("command", "") if isinstance(h, dict) else ""
                cmd = re.sub(r"\s+", " ", cmd).strip()
                if cmd:
                    out.append(Hook(origin, event, matcher, cmd, plugin_root))


def installed_plugins(directory: Path) -> list[tuple[str, str, Path]]:
    """(name, version, install_path) for every installed plugin whose scope
    applies to the spawn dir. Respects settings enabledPlugins:false."""
    reg = claude_dir() / "plugins" / "installed_plugins.json"
    try:
        data = json.loads(reg.read_text())
    except (OSError, json.JSONDecodeError, ValueError):
        return []
    disabled: set[str] = set()
    for sf in ("settings.json", "settings.local.json"):
        try:
            s = json.loads((claude_dir() / sf).read_text())
            for name, on in (s.get("enabledPlugins") or {}).items():
                if on is False:
                    disabled.add(name)
        except (OSError, json.JSONDecodeError, ValueError, AttributeError):
            pass
    out: list[tuple[str, str, Path]] = []
    for name, entries in (data.get("plugins") or {}).items():
        if name in disabled or not isinstance(entries, list):
            continue
        for e in entries:
            if not isinstance(e, dict):
                continue
            if e.get("scope") == "project":
                proj = e.get("projectPath", "")
                if not proj or not str(directory.resolve()).startswith(
                        str(Path(proj).expanduser().resolve())):
                    continue
            ip = Path(e.get("installPath", ""))
            if ip.is_dir():
                out.append((name, str(e.get("version", "?")), ip))
                break
    return out


def all_hooks(directory: Path) -> list[Hook]:
    """Every hook the harness would register: user settings, then every
    installed plugin's hooks.json, then (dev fallback) the source-repo
    plugin manifest pict itself ships in. Dedupe on (event, matcher, cmd)."""
    out: list[Hook] = []
    for sf in ("settings.json", "settings.local.json"):
        _hooks_from_json(display(claude_dir() / sf), claude_dir() / sf, None, out)
    for name, version, ip in installed_plugins(directory):
        _hooks_from_json(f"plugin {name} @{version}", ip / "hooks" / "hooks.json",
                         ip, out)
    _hooks_from_json("plugin hooks.json (source repo)",
                     PLUGIN_BIN.parent / "hooks" / "hooks.json",
                     PLUGIN_BIN.parent, out)
    seen: set[tuple[str, str, str]] = set()
    deduped: list[Hook] = []
    for h in out:
        key = (h.event, h.matcher, h.command)
        if key in seen:
            continue
        seen.add(key)
        deduped.append(h)
    return deduped


def _matcher_hits_startup(matcher: str) -> bool:
    if matcher in ("*", ""):
        return True
    try:
        return re.fullmatch(matcher, "startup") is not None
    except re.error:
        return False


def exec_session_hooks(directory: Path, hooks: list[Hook],
                       sources: list[Source]) -> None:
    """Run SessionStart hooks and render what each injects. The JStack
    timeline injector is skipped — gather_timeline() emulates it read-only."""
    stdin_payload = json.dumps({
        "hook_event_name": "SessionStart", "source": "startup",
        "session_id": "pict-preview", "cwd": str(directory),
    })
    for h in hooks:
        if h.event != "SessionStart" or not _matcher_hits_startup(h.matcher):
            continue
        if "session-start-inject" in h.command:
            h.executed = True  # emulated by gather_timeline, never re-run
            continue
        cmd = h.command
        env = dict(os.environ)
        if h.plugin_root is not None:
            cmd = cmd.replace("${CLAUDE_PLUGIN_ROOT}", str(h.plugin_root))
            env["CLAUDE_PLUGIN_ROOT"] = str(h.plugin_root)
        try:
            r = subprocess.run(["/bin/sh", "-c", cmd], input=stdin_payload,
                               capture_output=True, text=True, timeout=15,
                               env=env, cwd=str(directory))
            raw = r.stdout.strip()
        except (OSError, subprocess.SubprocessError):
            raw = ""
        h.executed = True
        injected = raw
        if raw.startswith("{"):
            try:
                parsed = json.loads(raw)
                injected = (parsed.get("hookSpecificOutput", {}) or {}) \
                    .get("additionalContext", "") or parsed.get("additionalContext", "")
            except (json.JSONDecodeError, ValueError, AttributeError):
                pass
        label = f"SessionStart · {h.origin}"
        mech = f"SessionStart hook (executed) — `{h.command[:80]}`"
        if injected:
            add(sources, "start", label, mech, injected)
        else:
            add(sources, "start", label, mech + " — no context injected", None)


# --------------------------------------------------- SessionStart (timeline)

def review_config() -> dict:
    cfg_path = Path(os.environ.get("JSTACK_REVIEW_CONFIG",
                                   str(claude_dir() / "jstack" / "review.json"))).expanduser()
    try:
        data = json.loads(cfg_path.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError, ValueError):
        return {}


def resolve_seat(directory: Path, root: Path) -> tuple[str | None, str | None]:
    """Same contract as session-start-inject.py resolve()."""
    try:
        rel = directory.resolve().relative_to(root.resolve())
    except (ValueError, OSError):
        return None, None
    if not rel.parts:
        return None, None
    agent_dir = root / rel.parts[0]
    if not (agent_dir / "CLAUDE.md").is_file():
        return None, None
    submode = rel.parts[1] if len(rel.parts) >= 2 else "chat"
    return agent_dir.name.lower(), submode.lower()


def timeline_count(cfg: dict, agent: str, submode: str) -> tuple[int, str]:
    inject = cfg.get("timeline_inject")
    if not isinstance(inject, dict):
        return 0, ""
    interactive = os.environ.get("PICT_INTERACTIVE", "1") != "0"
    for key in (f"{agent}/{submode}", f"*/{submode}"):
        if key not in inject:
            continue
        val = inject[key]
        try:
            if isinstance(val, dict):
                n = int(val.get("n", 0))
                if val.get("interactive_only"):
                    if not interactive:
                        return 0, f"config `{key}`: interactive_only — headless spawn gets nothing"
                    return n, f"config `{key}`: n={n}, interactive_only"
                return n, f"config `{key}`: n={n}"
            return int(val), f"config `{key}`: n={int(val)}"
        except (TypeError, ValueError):
            return 0, ""
    return 0, "no timeline_inject key matches this seat"


def gather_timeline(directory: Path, sources: list[Source]) -> None:
    cfg = review_config()
    root = Path(cfg.get("agent_root") or "~/Agents").expanduser()
    agent, submode = resolve_seat(directory, root)
    mech = "SessionStart hook — jstack session-start-inject.py (emulated read-only)"
    if agent is None or submode == "review":
        add(sources, "start", "(no timeline injection)",
            mech + " — dir is not an agent seat", None)
        return
    n, why = timeline_count(cfg, agent, submode)
    seat = f"{agent}/{submode}"
    if n <= 0:
        add(sources, "start", f"(no timeline injection) seat `{seat}`",
            mech + (f" — {why}" if why else ""), None)
        return
    log_event = os.environ.get("PICT_LOG_EVENT", str(PLUGIN_BIN / "log_event"))
    try:
        r = subprocess.run([log_event, "tail", seat, "-n", str(n)],
                           capture_output=True, text=True, timeout=8)
        entries = r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        entries = ""
    if not entries:
        add(sources, "start", f"(timeline empty) seat `{seat}`",
            mech + f" — {why}", None)
        return
    add(sources, "start", f"timeline tail — seat `{seat}`",
        mech + f" — {why}, wrapped in <jstack-timeline>", entries)


# ------------------------------------------------------------------- prompt

def resolve_command(name: str, directory: Path) -> Path | None:
    """The harness's own search order: nearest `.claude/commands/<name>.md`
    walking UP from the spawn dir, then the user-level commands dir."""
    stop = walk_root().resolve()
    for level in [directory] + list(directory.parents):
        if not str(level).startswith(str(stop)):
            break
        cand = level / ".claude" / "commands" / f"{name}.md"
        if cand.is_file():
            return cand
    cand = claude_dir() / "commands" / f"{name}.md"
    return cand if cand.is_file() else None


def gather_prompt(prompt: str, directory: Path, sources: list[Source]) -> None:
    text = prompt.strip()
    if not text.startswith("/"):
        add(sources, "prompt", "(-p prompt, literal)",
            "the -p payload IS the first user message", text)
        return
    parts = text[1:].split(None, 1)
    name = parts[0]
    args = parts[1] if len(parts) > 1 else ""
    cand = resolve_command(name, directory)
    wrapper = (f"<command-name>/{name}</command-name>"
               + (f" <command-args>{args}</command-args>" if args else ""))
    if cand is None:
        add(sources, "prompt", f"/{name} (COMMAND NOT FOUND)",
            "command expansion — no matching .claude/commands file on the "
            "walk-up or in the user commands dir", None, wrapper)
        return
    note = wrapper
    if cand.is_symlink():
        note += f" · symlink → {display(cand.resolve())}"
    body = strip_frontmatter(read_or_none(cand) or "")
    argv = args.split()
    subst = body.replace("$ARGUMENTS", args)
    subst = re.sub(r"\$(\d+)",
                   lambda m: argv[int(m.group(1)) - 1]
                   if 0 < int(m.group(1)) <= len(argv) else "", subst)
    if len(subst) != len(body):
        note += (f" · harness substituted $ARGUMENTS/$n "
                 f"({len(body) - len(subst):+d} chars)".replace("+-", "−"))
    add(sources, "prompt", f"/{name} → {display(cand)}",
        "command expansion — the -p prompt names this command; its body "
        "(frontmatter stripped, $ARGUMENTS/$n substituted) follows the "
        "wrapper in the first user message", subst, note)


def gather_serves(serves: list[Path], sources: list[Source]) -> None:
    for f in serves:
        body = read_or_none(f)
        if body is None:
            add(sources, "served", display(f),
                "tool-served payload — FILE UNREADABLE", None)
        else:
            add(sources, "served", display(f),
                "tool-served payload — arrives mid-session as a tool result "
                "(captured copy)", body)


# ------------------------------------------------------------- request mode

_WALKUP_FILE = re.compile(r"^Contents of (\S+) \(([^)]*)\)", re.M)
_WALKUP_STUB = re.compile(r"^# (claudeMd|userEmail|currentDate)\b", re.M)


def _symlink_alias(target: Path) -> str | None:
    """The wire prints RESOLVED paths — a rule wired in as a
    `~/.claude/rules/*` symlink shows up under its target path, hiding how
    it actually loads. Name the symlink so the wiring is visible."""
    rd = rules_dir()
    if not rd.is_dir():
        return None
    for p in rd.iterdir():
        if p.is_symlink():
            try:
                if p.resolve() == target.resolve():
                    return display(p)
            except OSError:
                continue
    return None


def _walkup_marks(text: str) -> list[tuple[int, str, str]]:
    """Boundary positions of every per-source section inside a claudeMd
    system-reminder: each `Contents of <path> (<why>)` file plus the harness
    stubs, in wire order. Returns (offset, path-or-stub, how-it-loads)."""
    marks: list[tuple[int, str, str]] = []
    for m in _WALKUP_FILE.finditer(text):
        note = m.group(2)
        alias = _symlink_alias(Path(m.group(1)))
        if alias:
            note += f" · wired as symlink `{alias}`"
        marks.append((m.start(), m.group(1), note))
    for m in _WALKUP_STUB.finditer(text):
        marks.append((m.start(), f"# {m.group(1)} stub", "no file — harness text"))
    marks.sort()
    return marks


def _walkup_subrows(text: str) -> list[tuple[str, int, str]]:
    marks = _walkup_marks(text)
    rows: list[tuple[str, int, str]] = []
    for i, (pos, label, note) in enumerate(marks):
        end = marks[i + 1][0] if i + 1 < len(marks) else len(text)
        rows.append((label, len(text[pos:end].encode()), note))
    return rows


def _attr_system_block(text: str) -> str:
    if text.startswith("x-anthropic-billing-header"):
        return "claude binary — billing header"
    if "Claude Agent SDK" in text and len(text) < 200:
        return "claude binary — SDK line"
    if text.startswith("You are Claude Code") and len(text) > 4000:
        return "claude binary — default harness prompt (gitStatus tail included)"
    return "spawn flag — `--system-prompt` / `--append-system-prompt`"


def render_request(path: Path, directory: Path | None = None) -> str:
    """Byte-truth mode: render a captured /v1/messages request body — every
    system block, tool schema, and message part, verbatim, in wire order,
    each attributed to what loads it (file, binary, flag, or hook)."""
    directory = (directory or Path.cwd()).resolve()
    req = json.loads(path.read_text())
    total_bytes = len(path.read_bytes())

    Sub = list[tuple[str, int, str]]
    comps: list[tuple[str, str, str, str, Sub]] = []
    sysblocks = req.get("system") or []
    if isinstance(sysblocks, str):
        sysblocks = [{"text": sysblocks}]
    for i, b in enumerate(sysblocks):
        t = b.get("text", "") if isinstance(b, dict) else str(b)
        comps.append((f"system[{i}]", "system prompt block", t,
                      _attr_system_block(t), []))
    tools = req.get("tools") or []
    for t in tools:
        name = t.get("name", "?") if isinstance(t, dict) else "?"
        comps.append((f"tool schema — {name}", "tools[] entry (bytes as sent, "
                      "shown pretty-printed)", json.dumps(t, indent=1),
                      "claude binary — built-in schema", []))
    cmd_name: str | None = None
    for mi, m in enumerate(req.get("messages") or []):
        role = m.get("role", "?")
        content = m.get("content")
        if isinstance(content, str):
            src = ("SessionStart hook output — registered hooks run at spawn"
                   if "SessionStart hook additional context" in content
                   else "harness reminder" if content.startswith("<system-reminder>")
                   else "conversation")
            comps.append((f"messages[{mi}] ({role})", "string content", content,
                          src, []))
            continue
        for pi, part in enumerate(content or []):
            ptype = part.get("type", "?") if isinstance(part, dict) else "?"
            body = part.get("text", "") if isinstance(part, dict) else str(part)
            if ptype != "text" and not body:
                body = json.dumps(part, indent=1)
            subrows: Sub = []
            if "# claudeMd" in body and "Contents of" in body:
                src = "CLAUDE.md walk-up + always-on rules — per-file rows below"
                subrows = _walkup_subrows(body)
            elif "<command-name>" in body and len(body) < 1000:
                w = re.search(r"<command-name>/?([^<]+)</command-name>", body)
                cmd_name = w.group(1) if w else None
                src = "CLI — command wrapper for the -p prompt"
            elif cmd_name:
                cand = resolve_command(cmd_name, directory)
                if cand is not None:
                    src = f"`{display(cand)}`"
                    if cand.is_symlink():
                        src += f" → `{display(cand.resolve())}`"
                else:
                    src = (f"expanded body of `/{cmd_name}` — source file not "
                           f"found from `{display(directory)}`")
                cmd_name = None
            elif "SessionStart hook additional context" in body:
                src = "SessionStart hook output — registered hooks run at spawn"
            elif body.startswith("<system-reminder>"):
                src = "harness reminder"
            else:
                src = "-p payload / conversation"
            comps.append((f"messages[{mi}].content[{pi}] ({role} · {ptype})",
                          "message part", body, src, subrows))

    lines: list[str] = []
    lines.append(f"# pict --request — captured request `{display(path)}`\n")
    lines.append(f"Model `{req.get('model', '?')}` · request body {total_bytes:,} "
                 f"bytes · every component verbatim, in wire order · sources "
                 f"resolved from `{display(directory)}`.\n")
    lines.append("| # | component | bytes | % of request | source |")
    lines.append("|---|-----------|-------|--------------|--------|")
    for i, (label, _, body, src, subrows) in enumerate(comps, 1):
        b = len(body.encode())
        lines.append(f"| {i} | `{label}` | {b:,} | "
                     f"{100.0 * b / max(1, total_bytes):.1f}% | {src} |")
        for slabel, sbytes, snote in subrows:
            lines.append(f"| | ↳ `{slabel}` | {sbytes:,} | "
                         f"{100.0 * sbytes / max(1, total_bytes):.1f}% | {snote} |")
    lines.append(f"| | **request total (with JSON framing)** | **{total_bytes:,}** "
                 f"| 100% | |")
    lines.append("")
    total = len(comps)
    for i, (label, detail, body, src, _sub) in enumerate(comps, 1):
        lines.append("```")
        lines.append(BAR)
        lines.append(f"[{i}/{total}] BEGIN  {label}")
        lines.append(f"        {detail} · {len(body.encode()):,} bytes")
        lines.append(f"        source: {src.replace('`', '')}")
        lines.append(BAR)
        lines.append("```")
        lines.append("")
        if _sub:
            # composite block: break the body at every source boundary so
            # each injected file's start and end is visible
            marks = _walkup_marks(body)
            pre = body[: marks[0][0]] if marks else body
            if pre.strip():
                lines.append(pre.rstrip())
                lines.append("")
            for j, (pos, slabel, _n) in enumerate(marks):
                end = marks[j + 1][0] if j + 1 < len(marks) else len(body)
                lines.append("```")
                lines.append(f"──── [{i}.{j + 1}] {slabel} · "
                             f"{len(body[pos:end].encode()):,} bytes " + "─" * 8)
                lines.append("```")
                lines.append("")
                lines.append(body[pos:end].rstrip())
                lines.append("")
        else:
            lines.append(body.rstrip() if body.strip() else "(empty)")
            lines.append("")
        lines.append("```")
        lines.append(f"━━━━ END [{i}/{total}]  {label} " + "━" * max(4, 56 - len(label)))
        lines.append("```")
        lines.append("")
    return "\n".join(lines) + "\n"


# ------------------------------------------------------------------ document

BAR = "━" * 72


def banner_open(lines: list[str], s: Source, total: int) -> None:
    lines.append("```")
    lines.append(BAR)
    lines.append(f"[{s.order}/{total}] BEGIN  {s.label}")
    meta = s.mechanism
    if s.body is not None:
        meta += f" · {len(s.body.splitlines())} lines · ~{tokens(s.body)} tokens"
    for chunk in [meta[i:i + 100] for i in range(0, len(meta), 100)]:
        lines.append(f"        {chunk}")
    if s.note:
        lines.append(f"        {s.note}")
    lines.append(BAR)
    lines.append("```")


def banner_close(lines: list[str], s: Source, total: int) -> None:
    lines.append("```")
    lines.append(f"━━━━ END [{s.order}/{total}]  {s.label} " +
                 "━" * max(4, 60 - len(s.label)))
    lines.append("```")


def render(directory: Path, opts: dict) -> str:
    sources: list[Source] = []
    hooks = all_hooks(directory)
    gather_base_note(sources)
    gather_appends(opts["appends"], sources)
    gather_globals(sources)
    gather_walkup(directory, sources)
    gather_memory(directory, sources, opts["no_memory"])
    if opts["prompt"]:
        gather_prompt(opts["prompt"], directory, sources)
    if opts["exec_hooks"]:
        exec_session_hooks(directory, hooks, sources)
    gather_timeline(directory, sources)
    gather_serves(opts["serves"], sources)
    total = len(sources)

    candidates: dict[str, tuple[Path, list[str], str]] = {}
    rdir = rules_dir()
    if rdir.is_dir():
        for rule in sorted(rdir.glob("*.md")):
            text = read_or_none(rule)
            if text is None:
                continue
            globs = parse_paths_frontmatter(text)
            if globs:
                candidates[rule.stem] = (rule, globs, strip_frontmatter(text))
    hits = anchored_rules({s: g for s, (_, g, _) in candidates.items()}, directory)
    anchored = [candidates[s] for s in sorted(hits)]
    elsewhere = [(s, g) for s, (_, g, _) in sorted(candidates.items()) if s not in hits]
    appended = {}
    for a in opts["appends"]:
        try:
            appended[a.resolve()] = a
        except OSError:
            pass

    def dup_of_append(rule: Path) -> bool:
        try:
            return rule.resolve() in appended
        except OSError:
            return False

    lines: list[str] = []
    lines.append(f"# pict — composed context for `{display(directory)}`\n")
    lines.append("Every injected source in the order the model receives it, then the")
    lines.append("on-demand layer. Weights are ~tokens (bytes/4).\n")

    stage_totals = {k: 0 for k in STAGES}
    lines.append("| # | stage | source | mechanism | ~tokens |")
    lines.append("|---|-------|--------|-----------|---------|")
    for s in sources:
        w = tokens(s.body) if s.body else 0
        stage_totals[s.stage] += w
        lines.append(f"| {s.order} | {s.stage} | `{s.label}` | {s.mechanism} | {w or '—'} |")
    req_total = (stage_totals["system"] + stage_totals["context"]
                 + stage_totals["prompt"] + stage_totals["start"])
    lines.append(f"| | | **first request — emulatable share** (base prompt + tool "
                 f"schemas NOT included; see --request) | | **{req_total}** |")
    if stage_totals["served"]:
        lines.append(f"| | | **mid-session tool results (captured)** | | **{stage_totals['served']}** |")
    grand = sum(stage_totals.values())
    lines.append(f"| | | **TOTAL of the above** | | **{grand}** |")
    ondemand_total = 0
    for rule, globs, body in anchored:
        ondemand_total += tokens(body)
        dup = (" — **SAME FILE as the --append above: already in the system "
               "prompt; if this ever fires it injects TWICE**"
               if dup_of_append(rule) else "")
        lines.append(f"| · | on-demand | `{display(rule)}` | files matching "
                     f"`{', '.join(globs)}` exist here{dup} | {tokens(body)} |")
    if anchored:
        lines.append(f"| | | **on-demand pool (each loads only when its files are touched)** "
                     f"| | **{ondemand_total}** |")
    lines.append("")

    lines.append("## Injected context, in order\n")
    prev_stage = None
    for s in sources:
        if s.stage != prev_stage:
            lines.append(f"\n### {STAGES[s.stage]}\n")
            prev_stage = s.stage
        banner_open(lines, s, total)
        if s.body:
            lines.append("")
            lines.append(s.body.rstrip())
            lines.append("")
            banner_close(lines, s, total)
        lines.append("")

    lines.append("---\n")
    lines.append("## On-demand rules — matching files exist under this directory\n")
    lines.append("NOT loaded at spawn. Each loads only when one of its matching files")
    lines.append("is read/edited (native) or about to be mutated (JStack PreToolUse")
    lines.append("hook, re-injected after ~400KB of transcript growth).\n")
    if not anchored:
        lines.append("*(none)*\n")
    for rule, globs, body in anchored:
        lines.append("```")
        lines.append(BAR)
        lines.append(f"[rule] BEGIN  {display(rule)}")
        lines.append(f"        fires on `{', '.join(globs)}` · "
                     f"{len(body.splitlines())} lines · ~{tokens(body)} tokens")
        if dup_of_append(rule):
            lines.append("        SAME FILE as the --append: already in the "
                         "system prompt of this spawn. Body not repeated here.")
            lines.append(BAR)
            lines.append("```")
            lines.append("")
            continue
        lines.append(BAR)
        lines.append("```")
        lines.append("")
        lines.append(body.rstrip())
        lines.append("")
        lines.append("```")
        lines.append(f"━━━━ END [rule]  {display(rule)} " +
                     "━" * max(4, 56 - len(display(rule))))
        lines.append("```")
        lines.append("")

    if elsewhere:
        lines.append("---\n")
        lines.append("## Path rules with no matching files here\n")
        lines.append("Would fire only if the session touches matching paths elsewhere")
        lines.append("(cross-tree) or creates matching files:\n")
        for stem, globs in elsewhere:
            lines.append(f"- `{stem}` — `{', '.join(globs)}`")
        lines.append("")

    if hooks:
        lines.append("---\n")
        lines.append("## All registered hooks (user settings + installed plugins)\n")
        lines.append("Conditional injectors and gates. Listed, not executed" +
                     (" — except SessionStart hooks rendered above (--exec-hooks)."
                      if opts["exec_hooks"] else
                      " (pass --exec-hooks to run SessionStart hooks and see "
                      "what they inject)."))
        lines.append("")
        lines.append("| origin | event | matcher | command |")
        lines.append("|--------|-------|---------|---------|")
        for h in hooks:
            cmd = h.command if len(h.command) <= 100 else h.command[:97] + "..."
            mark = " ✱ rendered above" if h.executed else ""
            lines.append(f"| {h.origin} | {h.event} | `{h.matcher}` | `{cmd}`{mark} |")
        lines.append("")

    lines.append("---\n")
    lines.append("*Emulation cannot see: the base system prompt, tool schemas, the")
    lines.append("skills/commands description list, MCP server instructions, session")
    lines.append("guidance. For those bytes, capture a request and run")
    lines.append("`pict --request <file>`.*")
    return "\n".join(lines) + "\n"


def main(argv: list[str]) -> int:
    if any(a in ("-h", "--help") for a in argv[1:]):
        sys.stdout.write(__doc__.strip() + "\n")
        return 0
    opts = {"no_memory": False, "exec_hooks": False, "appends": [],
            "serves": [], "prompt": ""}
    positional: list[str] = []
    args = argv[1:]
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--headless":
            os.environ["PICT_INTERACTIVE"] = "0"
        elif a == "--no-memory":
            opts["no_memory"] = True
        elif a == "--exec-hooks":
            opts["exec_hooks"] = True
        elif a in ("--append", "--serve", "--prompt", "--request"):
            if i + 1 >= len(args):
                sys.stderr.write(f"pict: {a} needs a value\n")
                return 64
            val = args[i + 1]
            i += 1
            if a == "--append":
                opts["appends"].append(Path(val).expanduser())
            elif a == "--serve":
                opts["serves"].append(Path(val).expanduser())
            elif a == "--request":
                req = Path(val).expanduser()
                if not req.is_file():
                    sys.stderr.write(f"pict: not a file: {req}\n")
                    return 64
                try:
                    sys.stdout.write(render_request(req))
                except (json.JSONDecodeError, ValueError) as e:
                    sys.stderr.write(f"pict: {req} is not request JSON: {e}\n")
                    return 64
                return 0
            else:
                opts["prompt"] = val
        elif a.startswith("-"):
            sys.stderr.write(f"pict: unknown option {a}\n")
            return 64
        else:
            positional.append(a)
        i += 1
    if len(positional) > 1:
        sys.stderr.write("usage: pict [dir] [--headless] [--no-memory] [--exec-hooks] "
                         "[--append FILE]... [--prompt TEXT] [--serve FILE]...\n")
        return 64
    directory = Path(positional[0]).expanduser().resolve() if positional else Path.cwd()
    if not directory.is_dir():
        sys.stderr.write(f"pict: not a directory: {directory}\n")
        return 64
    sys.stdout.write(render(directory, opts))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
