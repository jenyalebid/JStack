#!/usr/bin/env python3
"""log_event — the timeline: sqlite store, day-md as a rendered view.

Write (unchanged CLI):
    log_event <agent[/submode]> "<headline>" [--at HH:MM] [--date YYYY-MM-DD]
              [--detail "..."]... [--pipeline-task <repo>#<issue>] [--session <id>]

Query / admin (first positional is the subcommand):
    log_event tail <agent[/submode]> [-n N] [--json]
        Last N entries for a seat, oldest→newest. Seat form filters agent+submode;
        bare agent matches all its submodes. Human format includes verdict lines.
    log_event verdict <agent[/submode]> <shipped|drift|blocked|empty> --note "..."
        Stamp the seat's LATEST entry with an independent verdict (meta review's
        "do not repeat" loop). Verdicts ride tail/injection output — they are NOT
        rendered into the day md, which stays strictly the day's spine.
    log_event render [--date YYYY-MM-DD]
        Re-render a day's md from the db (repair tool; writes happen automatically).
    log_event migrate [--force]
        Import legacy day-md files into the db. Idempotent: a date that already
        has rows is skipped (--force re-imports it). Reports per-file whether the
        re-render is byte-identical or reformatted (content preserved either way).

Store: {timeline_dir}/timeline.db (sqlite, WAL — concurrent writers safe).
The day file {YYYY-MM-DD}.md is a ONE-WAY render, never parsed back; the single
exception is migrate (and the automatic import-before-first-write of a legacy
date), which exists precisely so no pre-db content is ever silently dropped.

Timeline dir: $JSTACK_TIMELINE_DIR (default ~/Logs/Timeline). Format spec lives
in the jstack rule `timeline.md`. Source is `agent` or `agent/submode` — always
pass the submode when the seat is known (e.g. alpha/chat).

Self-contained: python3 stdlib only. No venv, no host imports.
"""

import json
import os
import re
import sqlite3
import sys
from datetime import datetime
from pathlib import Path

_BLOCK_HEADER_RE = re.compile(r"^(\d{2}:\d{2}) \[([^\]]+)\](.*)$")
_BARE_HEADER_RE = re.compile(r"^(\d{2}:\d{2}) (.+)$")   # pre-block era: no [source]
_VALID_VERDICTS = {"shipped", "drift", "blocked", "empty"}
_SUBCOMMANDS = {"tail", "verdict", "render", "migrate", "grep", "show", "recall"}

_SCHEMA = """
CREATE TABLE IF NOT EXISTS entries (
    id            INTEGER PRIMARY KEY AUTOINCREMENT,
    date          TEXT NOT NULL,
    time          TEXT NOT NULL,
    agent         TEXT NOT NULL,
    submode       TEXT NOT NULL DEFAULT '',
    headline      TEXT NOT NULL,
    details       TEXT NOT NULL DEFAULT '[]',
    pipeline_task TEXT,
    session_id    TEXT,
    verdict       TEXT,
    verdict_note  TEXT,
    context       TEXT NOT NULL DEFAULT '',
    created_at    TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_entries_seat ON entries(agent, submode, date, time);
CREATE INDEX IF NOT EXISTS idx_entries_date ON entries(date, time);
"""


def timeline_dir() -> Path:
    env = os.environ.get("JSTACK_TIMELINE_DIR", "").strip()
    if env:
        return Path(env).expanduser()
    return Path.home() / "Logs" / "Timeline"


def timeline_path(day: str | None = None) -> Path:
    d = day or datetime.now().strftime("%Y-%m-%d")
    root = timeline_dir()
    root.mkdir(parents=True, exist_ok=True)
    return root / f"{d}.md"


def db_path() -> Path:
    root = timeline_dir()
    root.mkdir(parents=True, exist_ok=True)
    return root / "timeline.db"


def connect() -> sqlite3.Connection:
    con = sqlite3.connect(db_path(), timeout=10)
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("PRAGMA busy_timeout=5000")
    con.executescript(_SCHEMA)
    # in-place upgrade for dbs created before a column existed
    cols = {r[1] for r in con.execute("PRAGMA table_info(entries)")}
    if "context" not in cols:
        con.execute("ALTER TABLE entries ADD COLUMN context TEXT NOT NULL DEFAULT ''")
    return con


def parse_source(source: str) -> tuple[str, str]:
    """'alpha/chat' → ('alpha', 'chat'); 'alpha' → ('alpha', '')."""
    source = source.strip().strip("/")
    if "/" in source:
        agent, submode = source.split("/", 1)
        return agent.strip(), submode.strip()
    return source, ""


def format_source(agent: str, submode: str) -> str:
    return f"{agent}/{submode}" if submode else agent


def _clean_details(details: list[str] | None) -> list[str]:
    out = []
    for d in details or []:
        d = d.strip()
        if not d:
            continue
        if d.startswith("- "):
            d = d[2:].strip()
        out.append(" ".join(d.split()))
    return out


def _format_block(source: str, headline: str, details: list[str], ts: str) -> str:
    """Header line + headline + bullets — the strict day-md block format."""
    headline = " ".join(headline.split())
    out = [f"{ts} [{source}]", headline]
    for d in details:
        out.append(f"- {d}")
    return "\n".join(out)


def render_day_text(con: sqlite3.Connection, day: str) -> str | None:
    """Render a date's rows to md text. No rows → None."""
    rows = con.execute(
        "SELECT time, agent, submode, headline, details FROM entries "
        "WHERE date = ? ORDER BY time, id", (day,),
    ).fetchall()
    if not rows:
        return None
    blocks = [
        _format_block(format_source(a, s), h, json.loads(dt), t)
        for t, a, s, h, dt in rows
    ]
    return "\n\n".join(blocks) + "\n"


def render_day(con: sqlite3.Connection, day: str) -> None:
    """One-way render of a date's rows to its md file. No rows → no write."""
    text = render_day_text(con, day)
    if text is not None:
        timeline_path(day).write_text(text)


# ---------------------------------------------------------------- legacy parse

def _split_blocks(text: str) -> list[tuple[str, str, str, list[str]]]:
    """Parse a legacy day-md into [(time, source, headline, details), ...].

    Handles every historical form so nothing is ever dropped:
    - block format: `HH:MM [source]` header, headline line, `- ` bullets
    - single-line:  `HH:MM [source] headline`
    - pre-block:    `HH:MM headline` (no source — imported as 'unknown')
    - orphan text before any header — imported as its own 'unknown' entry
    Non-bullet body lines inside a block are preserved as details.
    """
    entries: list[tuple[str, str, str, list[str]]] = []
    cur: dict | None = None

    def flush():
        nonlocal cur
        if cur is None:
            return
        headline = cur["headline"] or "(no headline)"
        entries.append((cur["time"], cur["source"], headline, cur["details"]))
        cur = None

    def start(time: str, source: str, headline: str):
        nonlocal cur
        flush()
        cur = {"time": time, "source": source,
               "headline": headline.strip(), "details": []}

    for line in text.splitlines():
        m = _BLOCK_HEADER_RE.match(line)
        if m:
            start(m.group(1), m.group(2), m.group(3))
            continue
        if line.strip() == "":
            flush()
            continue
        if cur is not None and not cur["headline"]:
            cur["headline"] = line.strip()   # block header's pending headline
            continue
        b = _BARE_HEADER_RE.match(line)
        if b:   # pre-block era entry — starts its own block even mid-entry
            start(b.group(1), "unknown", b.group(2))
            continue
        if cur is not None:
            body = line.strip()
            if body.startswith("- "):
                body = body[2:].strip()
            cur["details"].append(body)
        else:
            start("00:00", "unknown", line.strip())
    flush()
    return entries


def import_day_md(con: sqlite3.Connection, day: str, path: Path) -> int:
    """Insert a legacy day-md's blocks as rows. Caller ensures date has no rows."""
    now = datetime.now().isoformat(timespec="seconds")
    n = 0
    for ts, source, headline, details in _split_blocks(path.read_text()):
        agent, submode = parse_source(source)
        con.execute(
            "INSERT INTO entries (date, time, agent, submode, headline, details,"
            " pipeline_task, session_id, created_at)"
            " VALUES (?, ?, ?, ?, ?, ?, NULL, NULL, ?)",
            (day, ts, agent, submode, headline, json.dumps(details, ensure_ascii=False), now),
        )
        n += 1
    return n


def _absorb_strays(con: sqlite3.Connection, day: str) -> None:
    """Before any write+render, absorb md blocks the db doesn't know about.

    The md is a rendered view, but if ANYTHING else ever writes it directly (a
    stale plugin cache mid-upgrade, a hand edit, a rogue tool), a naive render
    would silently erase that entry — the exact two-writer clobber that killed
    the old continuity system. So: parse the current md, insert any block with
    no matching (time, agent, submode, headline) row, THEN render. Self-healing
    beats trusting every writer forever. Also covers first-write-to-a-legacy-day
    (all its blocks are strays → full import)."""
    path = timeline_dir() / f"{day}.md"
    try:
        text = path.read_text()
    except OSError:
        return
    if not text.strip():
        return
    now = datetime.now().isoformat(timespec="seconds")
    for ts, source, headline, details in _split_blocks(text):
        agent, submode = parse_source(source)
        headline = " ".join(headline.split())
        known = con.execute(
            "SELECT 1 FROM entries WHERE date = ? AND time = ? AND agent = ?"
            " AND submode = ? AND headline = ? LIMIT 1",
            (day, ts, agent, submode, headline),
        ).fetchone()
        if not known:
            con.execute(
                "INSERT INTO entries (date, time, agent, submode, headline,"
                " details, pipeline_task, session_id, created_at)"
                " VALUES (?, ?, ?, ?, ?, ?, NULL, NULL, ?)",
                (day, ts, agent, submode, headline,
                 json.dumps(details, ensure_ascii=False), now),
            )


# --------------------------------------------------------------------- writes

def _clamp_future(day: str, ts: str) -> tuple[str, str]:
    """The timeline records what happened — a stamp in the future is always a
    writer error (the classic: HH:MM or date copied from a UTC transcript
    timestamp). Future date → today, stamped now. Same-day future time (2-min
    grace) → now. Past days pass through untouched (legit late logging)."""
    now = datetime.now()
    today = now.strftime("%Y-%m-%d")
    if day > today:
        return today, now.strftime("%H:%M")
    if day == today:
        h, m = ts.split(":")
        if int(h) * 60 + int(m) > now.hour * 60 + now.minute + 2:
            return day, now.strftime("%H:%M")
    return day, ts


def append_timeline(source: str, text: str, day: str | None = None,
                    timestamp: str | None = None,
                    details: list[str] | None = None,
                    session_id: str | None = None,
                    context: str | None = None) -> None:
    if not source or not text:
        return
    d = day or datetime.now().strftime("%Y-%m-%d")
    ts = timestamp or datetime.now().strftime("%H:%M")
    d, ts = _clamp_future(d, ts)
    agent, submode = parse_source(source)
    con = connect()
    with con:
        _absorb_strays(con, d)
        con.execute(
            "INSERT INTO entries (date, time, agent, submode, headline, details,"
            " pipeline_task, session_id, context, created_at)"
            " VALUES (?, ?, ?, ?, ?, ?, NULL, ?, ?, ?)",
            (d, ts, agent, submode, " ".join(text.split()),
             json.dumps(_clean_details(details), ensure_ascii=False),
             session_id, (context or "").strip(),
             datetime.now().isoformat(timespec="seconds")),
        )
        render_day(con, d)
    con.close()


def consolidate_pipeline_entry(source: str, task_tag: str, text: str,
                               day: str | None = None,
                               timestamp: str | None = None,
                               details: list[str] | None = None,
                               session_id: str | None = None,
                               context: str | None = None) -> None:
    """One live entry per pipeline task: replace all rows carrying the tag
    (tagged column, or legacy tag-in-text) with one block, earliest ts kept."""
    if not source or not task_tag or not text:
        return
    headline = " ".join(text.split())
    if task_tag not in headline:
        headline = f"{task_tag} — {headline}"
    d = day or datetime.now().strftime("%Y-%m-%d")
    d, _ = _clamp_future(d, "00:00")   # day first — the tag match below runs on it
    agent, submode = parse_source(source)

    con = connect()
    with con:
        _absorb_strays(con, d)
        matched = con.execute(
            "SELECT id, time FROM entries WHERE date = ? AND"
            " (pipeline_task = ? OR headline LIKE ? OR details LIKE ?)",
            (d, task_tag, f"%{task_tag}%", f"%{task_tag}%"),
        ).fetchall()
        earliest = min((t for _, t in matched), default=None)
        if matched:
            con.executemany("DELETE FROM entries WHERE id = ?",
                            [(i,) for i, _ in matched])
        final_ts = timestamp or earliest or datetime.now().strftime("%H:%M")
        _, final_ts = _clamp_future(d, final_ts)
        con.execute(
            "INSERT INTO entries (date, time, agent, submode, headline, details,"
            " pipeline_task, session_id, context, created_at)"
            " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
            (d, final_ts, agent, submode, headline,
             json.dumps(_clean_details(details), ensure_ascii=False),
             task_tag, session_id, (context or "").strip(),
             datetime.now().isoformat(timespec="seconds")),
        )
        render_day(con, d)
    con.close()


def set_verdict(seat: str, verdict: str, note: str) -> str | None:
    """Stamp the seat's latest entry. Returns the stamped headline, or None."""
    agent, submode = parse_source(seat)
    con = connect()
    with con:
        where = "agent = ?" + (" AND submode = ?" if submode else "")
        params: tuple = (agent, submode) if submode else (agent,)
        row = con.execute(
            f"SELECT id, headline FROM entries WHERE {where}"
            " ORDER BY date DESC, time DESC, id DESC LIMIT 1", params,
        ).fetchone()
        if row is None:
            return None
        con.execute("UPDATE entries SET verdict = ?, verdict_note = ? WHERE id = ?",
                    (verdict, note, row[0]))
    con.close()
    return row[1]


# -------------------------------------------------------------------- queries

def tail_entries(seat: str, n: int) -> list[dict]:
    """Last n entries for a seat, oldest→newest. Bare agent = all submodes.

    A seat query also matches the agent's submode-less rows — entries migrated
    from the pre-seat era (and any bare-source writes). They age out of the
    last-n window as seat-tagged entries accrue; without this, every seat would
    boot blind right after migration."""
    agent, submode = parse_source(seat)
    con = connect()
    where = "agent = ?" + (" AND submode IN (?, '')" if submode else "")
    params: tuple = (agent, submode) if submode else (agent,)
    rows = con.execute(
        f"SELECT id, date, time, agent, submode, headline, details, verdict,"
        f" verdict_note, session_id, context FROM entries WHERE {where}"
        " ORDER BY date DESC, time DESC, id DESC LIMIT ?", params + (n,),
    ).fetchall()
    con.close()
    out = []
    for eid, date, ts, a, s, h, dt, v, vn, sid, ctx in reversed(rows):
        out.append({
            "id": eid, "date": date, "time": ts, "agent": a, "submode": s,
            "headline": h, "details": json.loads(dt),
            "verdict": v, "verdict_note": vn,
            "session_id": sid, "context": ctx,
        })
    return out


def format_tail(entries: list[dict]) -> str:
    """Default tail text — what seat injection boots on. Lean by design:
    headline + bullets + verdict only; `context` never rides (on-demand via
    --json or `show`)."""
    lines = []
    for e in entries:
        lines.append(f"{e['date']} {e['time']} — {e['headline']}")
        for d in e["details"]:
            lines.append(f"- {d}")
        if e["verdict"]:
            note = f" — {e['verdict_note']}" if e["verdict_note"] else ""
            lines.append(f"  ↳ verdict: {e['verdict']}{note}")
    return "\n".join(lines)


def grep_entries(pattern: str, seat: str | None = None,
                 since: str | None = None) -> list[dict]:
    """Substring search (case-insensitive) over headline + details + context,
    across all days and seats — the recall surface for 'when did we do X?'."""
    esc = (pattern.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_"))
    like = f"%{esc}%"
    where = ["(headline LIKE ? ESCAPE '\\' OR details LIKE ? ESCAPE '\\'"
             " OR context LIKE ? ESCAPE '\\')"]
    params: list = [like, like, like]
    if seat:
        agent, submode = parse_source(seat)
        where.append("agent = ?"); params.append(agent)
        if submode:
            where.append("submode = ?"); params.append(submode)
    if since:
        where.append("date >= ?"); params.append(since)
    con = connect()
    rows = con.execute(
        "SELECT id, date, time, agent, submode, headline FROM entries"
        f" WHERE {' AND '.join(where)} ORDER BY date, time, id", params,
    ).fetchall()
    con.close()
    return [{"id": i, "date": d, "time": t, "source": format_source(a, s),
             "headline": h} for i, d, t, a, s, h in rows]


def recall_entries(day_from: str, day_to: str,
                   seat: str | None = None) -> list[dict]:
    """A day (or range) replayed — the recall surface for date questions
    ('what happened Monday?'), optionally narrowed to one seat. Same store,
    same seat semantics as tail (bare agent = all its seats)."""
    where = ["date >= ?", "date <= ?"]
    params: list = [day_from, day_to]
    if seat:
        agent, submode = parse_source(seat)
        where.append("agent = ?"); params.append(agent)
        if submode:
            where.append("submode IN (?, '')"); params.append(submode)
    con = connect()
    rows = con.execute(
        "SELECT id, date, time, agent, submode, headline, details, verdict,"
        " verdict_note, session_id, context FROM entries"
        f" WHERE {' AND '.join(where)} ORDER BY date, time, id", params,
    ).fetchall()
    con.close()
    out = []
    for i, d, t, a, s, h, dt, v, vn, sid, ctx in rows:
        out.append({"id": i, "date": d, "time": t,
                    "source": format_source(a, s), "headline": h,
                    "details": json.loads(dt), "verdict": v,
                    "verdict_note": vn, "session_id": sid, "context": ctx})
    return out


def format_recall(entries: list[dict], full: bool = False) -> str:
    """Day-md-shaped blocks plus what the md never shows: ids, seat verdicts,
    and (with full) each entry's context."""
    blocks = []
    for e in entries:
        lines = [f"#{e['id']} {e['date']} {e['time']} [{e['source']}]",
                 e["headline"]]
        for d in e["details"]:
            lines.append(f"- {d}")
        if e["verdict"]:
            note = f" — {e['verdict_note']}" if e["verdict_note"] else ""
            lines.append(f"  ↳ verdict: {e['verdict']}{note}")
        if full and e["context"]:
            lines.append(f"context:\n{e['context']}")
        blocks.append("\n".join(lines))
    return "\n\n".join(blocks)


def show_entry(entry_id: int) -> dict | None:
    """Everything one entry holds — the on-demand loader behind a grep/tail hit."""
    con = connect()
    row = con.execute(
        "SELECT id, date, time, agent, submode, headline, details,"
        " pipeline_task, session_id, verdict, verdict_note, context"
        " FROM entries WHERE id = ?", (entry_id,),
    ).fetchone()
    con.close()
    if row is None:
        return None
    i, d, t, a, s, h, dt, pt, sid, v, vn, ctx = row
    return {"id": i, "date": d, "time": t, "source": format_source(a, s),
            "headline": h, "details": json.loads(dt), "pipeline_task": pt,
            "session_id": sid, "verdict": v, "verdict_note": vn, "context": ctx}


# -------------------------------------------------------------------- migrate

def migrate(force: bool = False) -> int:
    """Import legacy day-mds. STRICTLY non-destructive: a file whose re-render
    is not byte-identical is rolled back and left as md-only history — the
    original file is never rewritten. --force imports it anyway (rows land in
    the db, the md is still left untouched)."""
    root = timeline_dir()
    con = connect()
    day_files = sorted(p for p in root.glob("????-??-??.md"))
    if not day_files:
        print(f"migrate: no day files in {root}")
        return 0
    md_only = 0
    for path in day_files:
        day = path.stem
        original = path.read_text()
        if not original.strip():
            print(f"  {day}: empty — skipped")
            continue
        has_rows = con.execute(
            "SELECT COUNT(*) FROM entries WHERE date = ?", (day,)
        ).fetchone()[0]
        if has_rows:
            print(f"  {day}: skipped ({has_rows} rows already in db)")
            continue
        con.execute("BEGIN")
        n = import_day_md(con, day, path)
        rendered = render_day_text(con, day)
        if rendered == original:
            con.execute("COMMIT")
            print(f"  {day}: {n} entries — byte-identical")
        elif force:
            con.execute("COMMIT")
            print(f"  {day}: {n} entries — imported (md left untouched, render differs)")
        else:
            con.execute("ROLLBACK")
            md_only += 1
            print(f"  {day}: left as md-only (pre-block format — rerun with --force to import)")
    con.close()
    if md_only:
        print(f"migrate: {md_only} file(s) left md-only; their content stays exactly as-is either way")
    return 0


# ------------------------------------------------------------------------ CLI

def _write_usage() -> str:
    return ('usage: log_event <agent[/submode]> "<headline>" [--at HH:MM] '
            '[--date YYYY-MM-DD] [--detail "..."]... [--context "..."] '
            '[--pipeline-task <tag>] [--session <id>]\n'
            '       (--at/--date default to now/today, machine-local — omit '
            'unless logging an earlier event)\n'
            '   or: log_event tail <agent[/submode]> [-n N] [--json]\n'
            '   or: log_event grep "<substring>" [--seat <agent[/submode]>] '
            '[--since YYYY-MM-DD] [--json]\n'
            '   or: log_event recall <YYYY-MM-DD[..YYYY-MM-DD]> '
            '[<agent[/submode]>|all] [--full] [--json]\n'
            '   or: log_event show <id>\n'
            '   or: log_event verdict <agent[/submode]> '
            '<shipped|drift|blocked|empty> --note "..."\n'
            '   or: log_event render [--date YYYY-MM-DD]\n'
            '   or: log_event migrate [--force]')


def _cmd_tail(rest: list[str]) -> int:
    seat, n, as_json = None, 10, False
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "-n":
            n = int(rest[i + 1]); i += 2
        elif a == "--json":
            as_json = True; i += 1
        elif a.startswith("-"):
            print(f"log_event tail: unknown flag {a}", file=sys.stderr)
            return 2
        elif seat is not None:
            print(f"log_event tail: one seat only (got {seat!r} and {a!r})",
                  file=sys.stderr)
            return 2
        else:
            seat = a; i += 1
    if not seat:
        print("log_event tail: seat required (agent or agent/submode)", file=sys.stderr)
        return 2
    entries = tail_entries(seat, n)
    if as_json:
        print(json.dumps(entries, ensure_ascii=False, indent=2))
    elif entries:
        print(format_tail(entries))
    return 0


def _cmd_grep(rest: list[str]) -> int:
    pattern, seat, since, as_json = None, None, None, False
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--seat":
            seat = rest[i + 1]; i += 2
        elif a == "--since":
            since = rest[i + 1]; i += 2
        elif a == "--json":
            as_json = True; i += 1
        elif a.startswith("-"):
            print(f"log_event grep: unknown flag {a}", file=sys.stderr)
            return 2
        elif pattern is not None:
            print(f"log_event grep: one pattern only (got {pattern!r} and {a!r})"
                  " — quote multi-word patterns", file=sys.stderr)
            return 2
        else:
            pattern = a; i += 1
    if not pattern:
        print('log_event grep: pattern required', file=sys.stderr)
        return 2
    hits = grep_entries(pattern, seat=seat, since=since)
    if as_json:
        print(json.dumps(hits, ensure_ascii=False, indent=2))
    else:
        for h in hits:
            print(f"#{h['id']} {h['date']} {h['time']} [{h['source']}] {h['headline']}")
    return 0 if hits else 1


def _cmd_recall(rest: list[str]) -> int:
    dates, seat, full, as_json = None, None, False, False
    pos: list[str] = []
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--full":
            full = True; i += 1
        elif a == "--json":
            as_json = True; i += 1
        elif a.startswith("-"):
            print(f"log_event recall: unknown flag {a}", file=sys.stderr)
            return 2
        else:
            pos.append(a); i += 1
    if len(pos) > 2:
        print(f"log_event recall: too many arguments: {' '.join(pos[2:])}",
              file=sys.stderr)
        return 2
    if pos:
        dates = pos[0]
    if len(pos) >= 2 and pos[1] != "all":
        seat = pos[1]
    if not dates:
        print("log_event recall: date required (YYYY-MM-DD or "
              "YYYY-MM-DD..YYYY-MM-DD)", file=sys.stderr)
        return 2
    day_from, _, day_to = dates.partition("..")
    day_to = day_to or day_from
    if not (re.fullmatch(r"\d{4}-\d{2}-\d{2}", day_from)
            and re.fullmatch(r"\d{4}-\d{2}-\d{2}", day_to)):
        print(f"log_event recall: bad date '{dates}' (expected YYYY-MM-DD or "
              "YYYY-MM-DD..YYYY-MM-DD)", file=sys.stderr)
        return 2
    entries = recall_entries(day_from, day_to, seat=seat)
    if as_json:
        print(json.dumps(entries, ensure_ascii=False, indent=2))
    elif entries:
        print(format_recall(entries, full=full))
    return 0 if entries else 1


def _cmd_show(rest: list[str]) -> int:
    try:
        entry_id = int(rest[0])
    except (IndexError, ValueError):
        print("log_event show: numeric entry id required (from grep/tail --json)",
              file=sys.stderr)
        return 2
    e = show_entry(entry_id)
    if e is None:
        print(f"log_event show: no entry #{entry_id}", file=sys.stderr)
        return 1
    print(f"#{e['id']} {e['date']} {e['time']} [{e['source']}]")
    print(e["headline"])
    for d in e["details"]:
        print(f"- {d}")
    if e["pipeline_task"]:
        print(f"pipeline-task: {e['pipeline_task']}")
    if e["session_id"]:
        print(f"session: {e['session_id']}")
    if e["verdict"]:
        note = f" — {e['verdict_note']}" if e["verdict_note"] else ""
        print(f"↳ verdict: {e['verdict']}{note}")
    if e["context"]:
        print(f"context:\n{e['context']}")
    return 0


def _cmd_verdict(rest: list[str]) -> int:
    note = ""
    pos: list[str] = []
    i = 0
    while i < len(rest):
        if rest[i] == "--note":
            note = rest[i + 1]; i += 2
        else:
            pos.append(rest[i]); i += 1
    if len(pos) != 2 or pos[1] not in _VALID_VERDICTS:
        print(f"log_event verdict: need <agent[/submode]> <{'|'.join(sorted(_VALID_VERDICTS))}> --note",
              file=sys.stderr)
        return 2
    stamped = set_verdict(pos[0], pos[1], note)
    if stamped is None:
        print(f"log_event verdict: no entries for {pos[0]}", file=sys.stderr)
        return 1
    print(f"verdict[{pos[1]}] → {pos[0]}: {stamped[:80]}")
    return 0


def _cmd_render(rest: list[str]) -> int:
    day = datetime.now().strftime("%Y-%m-%d")
    if "--date" in rest:
        day = rest[rest.index("--date") + 1]
    con = connect()
    render_day(con, day)
    con.close()
    print(f"rendered: {timeline_path(day)}")
    return 0


def main(argv: list[str]) -> int:
    if not argv:
        print(_write_usage(), file=sys.stderr)
        return 2

    if argv[0] in _SUBCOMMANDS:
        cmd, rest = argv[0], argv[1:]
        if cmd == "tail":
            return _cmd_tail(rest)
        if cmd == "grep":
            return _cmd_grep(rest)
        if cmd == "recall":
            return _cmd_recall(rest)
        if cmd == "show":
            return _cmd_show(rest)
        if cmd == "verdict":
            return _cmd_verdict(rest)
        if cmd == "render":
            return _cmd_render(rest)
        if cmd == "migrate":
            return migrate(force="--force" in rest)

    if len(argv) < 2:
        print(_write_usage(), file=sys.stderr)
        return 2

    source = argv[0]
    rest = argv[1:]
    timestamp = day = pipeline_task = session_id = context = None
    details: list[str] = []
    words: list[str] = []

    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--at":
            timestamp = rest[i + 1]; i += 2
        elif a == "--date":
            day = rest[i + 1]; i += 2
        elif a == "--pipeline-task":
            pipeline_task = rest[i + 1]; i += 2
        elif a == "--detail":
            details.append(rest[i + 1]); i += 2
        elif a == "--context":
            context = rest[i + 1]; i += 2
        elif a == "--session":
            session_id = rest[i + 1]; i += 2
        else:
            words.append(a); i += 1

    text = " ".join(words)
    if timestamp and not re.fullmatch(r"\d{2}:\d{2}", timestamp):
        print(f"log_event: bad --at '{timestamp}' (expected HH:MM)", file=sys.stderr)
        return 2
    if day and not re.fullmatch(r"\d{4}-\d{2}-\d{2}", day):
        print(f"log_event: bad --date '{day}' (expected YYYY-MM-DD)", file=sys.stderr)
        return 2

    label = day if day else "today"
    if pipeline_task:
        consolidate_pipeline_entry(source, pipeline_task, text, day=day,
                                   timestamp=timestamp, details=details,
                                   session_id=session_id, context=context)
        print(f"consolidated: {source} ({label}) [{pipeline_task}] {text[:80]}")
    else:
        append_timeline(source, text, day=day, timestamp=timestamp,
                        details=details, session_id=session_id, context=context)
        print(f"logged: {source} ({label}) {text[:80]}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
