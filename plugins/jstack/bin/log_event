#!/usr/bin/env python3
"""log_event — the timeline: a single sqlite store, no rendered files.

Write:
    log_event <agent[/submode]> "<headline>" [--at HH:MM] [--date YYYY-MM-DD]
              [--detail "..."]... [--context "..."] [--origin direct|indirect]
              [--pipeline-task <repo>#<issue>] [--session <id>]

Query / admin (first positional is the subcommand):
    log_event tail <agent[/submode]> [-n N] [--json]
        Last N entries for a seat, oldest→newest. Seat form filters agent+submode;
        bare agent matches all its submodes. Human format includes verdict lines.
    log_event grep "<substring>" [--seat <seat>] [--since YYYY-MM-DD] [--json]
    log_event recall <YYYY-MM-DD[..YYYY-MM-DD]> [<seat>|all] [--full] [--json]
    log_event show <id>
    log_event verdict <agent[/submode]> <shipped|drift|blocked|empty> --note "..."
        Stamp the seat's LATEST entry with an independent verdict (meta review's
        "do not repeat" loop). Verdicts ride tail/injection output.

Origin marks who drove the session the entry came from: `direct` (a human at
the wheel) or `indirect` (cron/gateway/spawned work). Resolution: --origin
flag > JSTACK_TIMELINE_ORIGIN env > direct. Pre-origin rows read back as ''.

Store: {timeline_dir}/timeline.db (sqlite, WAL — concurrent writers safe).
Timeline dir: $JSTACK_TIMELINE_DIR (default ~/Logs/Timeline). Format spec lives
in the jstack rule `timeline.md`. Source is `agent` or `agent/submode` — always
pass the submode when the seat is known (e.g. alpha/chat).

Self-contained: python3 stdlib only. No venv, no host imports.
"""

import json
import os
import re
import sqlite3
import sys
from datetime import datetime
from pathlib import Path

_VALID_VERDICTS = {"shipped", "drift", "blocked", "empty"}
_VALID_ORIGINS = {"direct", "indirect"}
_SUBCOMMANDS = {"tail", "verdict", "grep", "show", "recall"}

_SCHEMA = """
CREATE TABLE IF NOT EXISTS entries (
    id            INTEGER PRIMARY KEY AUTOINCREMENT,
    date          TEXT NOT NULL,
    time          TEXT NOT NULL,
    agent         TEXT NOT NULL,
    submode       TEXT NOT NULL DEFAULT '',
    headline      TEXT NOT NULL,
    details       TEXT NOT NULL DEFAULT '[]',
    pipeline_task TEXT,
    session_id    TEXT,
    verdict       TEXT,
    verdict_note  TEXT,
    context       TEXT NOT NULL DEFAULT '',
    origin        TEXT NOT NULL DEFAULT '',
    created_at    TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_entries_seat ON entries(agent, submode, date, time);
CREATE INDEX IF NOT EXISTS idx_entries_date ON entries(date, time);
"""


def timeline_dir() -> Path:
    env = os.environ.get("JSTACK_TIMELINE_DIR", "").strip()
    if env:
        return Path(env).expanduser()
    return Path.home() / "Logs" / "Timeline"


def db_path() -> Path:
    root = timeline_dir()
    root.mkdir(parents=True, exist_ok=True)
    return root / "timeline.db"


def connect() -> sqlite3.Connection:
    con = sqlite3.connect(db_path(), timeout=10)
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("PRAGMA busy_timeout=5000")
    con.executescript(_SCHEMA)
    # in-place upgrade for dbs created before a column existed
    cols = {r[1] for r in con.execute("PRAGMA table_info(entries)")}
    if "context" not in cols:
        con.execute("ALTER TABLE entries ADD COLUMN context TEXT NOT NULL DEFAULT ''")
    if "origin" not in cols:
        con.execute("ALTER TABLE entries ADD COLUMN origin TEXT NOT NULL DEFAULT ''")
    return con


def default_origin() -> str:
    """Env default for unattended plumbing; anything unrecognized → direct.
    A bad env value must never block a write — origin is metadata."""
    env = os.environ.get("JSTACK_TIMELINE_ORIGIN", "").strip().lower()
    return env if env in _VALID_ORIGINS else "direct"


def parse_source(source: str) -> tuple[str, str]:
    """'alpha/chat' → ('alpha', 'chat'); 'alpha' → ('alpha', '')."""
    source = source.strip().strip("/")
    if "/" in source:
        agent, submode = source.split("/", 1)
        return agent.strip(), submode.strip()
    return source, ""


_WRITE_VERBS = {"add", "append", "write", "log", "record", "entry", "new"}
_SEAT_RE = re.compile(r"[a-z][a-z0-9_.-]*(/[a-z0-9][a-z0-9_./-]*)?")


def _seat_error(source: str, rest: list[str]) -> str | None:
    """Reject a non-seat first positional before it becomes a timeline agent.

    Every observed corruption shape lands here: a hallucinated write verb
    ('log_event add alpha/chat ...' — the verb becomes the agent and the real
    seat is swallowed into the headline), a flag promoted to agent
    ('log_event --at ...'), or a token outside the seat charset."""
    if source.startswith("-"):
        return (f"log_event: '{source}' is not a seat — a write starts with "
                f"agent[/submode], flags come after.\n{_write_usage()}")
    if source in _WRITE_VERBS:
        hint = ""
        if rest:
            tok = rest[0].split()[0] if rest[0].split() else ""
            if _SEAT_RE.fullmatch(tok):
                hint = f'\n  did you mean: log_event {tok} "<headline>" ...'
        return (f"log_event: no '{source}' subcommand — a write has no verb, "
                f"it starts with the seat itself.{hint}\n{_write_usage()}")
    if not _SEAT_RE.fullmatch(source.strip().strip("/")):
        return (f"log_event: '{source}' is not a valid seat "
                f"(agent[/submode], lowercase).\n{_write_usage()}")
    return None


def format_source(agent: str, submode: str) -> str:
    return f"{agent}/{submode}" if submode else agent


def _clean_details(details: list[str] | None) -> list[str]:
    out = []
    for d in details or []:
        d = d.strip()
        if not d:
            continue
        if d.startswith("- "):
            d = d[2:].strip()
        out.append(" ".join(d.split()))
    return out


# --------------------------------------------------------------------- writes

def _clamp_future(day: str, ts: str) -> tuple[str, str]:
    """The timeline records what happened — a stamp in the future is always a
    writer error (the classic: HH:MM or date copied from a UTC transcript
    timestamp). Future date → today, stamped now. Same-day future time (2-min
    grace) → now. Past days pass through untouched (legit late logging)."""
    now = datetime.now()
    today = now.strftime("%Y-%m-%d")
    if day > today:
        return today, now.strftime("%H:%M")
    if day == today:
        h, m = ts.split(":")
        if int(h) * 60 + int(m) > now.hour * 60 + now.minute + 2:
            return day, now.strftime("%H:%M")
    return day, ts


def append_timeline(source: str, text: str, day: str | None = None,
                    timestamp: str | None = None,
                    details: list[str] | None = None,
                    session_id: str | None = None,
                    context: str | None = None,
                    origin: str | None = None) -> None:
    if not source or not text:
        return
    d = day or datetime.now().strftime("%Y-%m-%d")
    ts = timestamp or datetime.now().strftime("%H:%M")
    d, ts = _clamp_future(d, ts)
    agent, submode = parse_source(source)
    con = connect()
    with con:
        con.execute(
            "INSERT INTO entries (date, time, agent, submode, headline, details,"
            " pipeline_task, session_id, context, origin, created_at)"
            " VALUES (?, ?, ?, ?, ?, ?, NULL, ?, ?, ?, ?)",
            (d, ts, agent, submode, " ".join(text.split()),
             json.dumps(_clean_details(details), ensure_ascii=False),
             session_id, (context or "").strip(), origin or default_origin(),
             datetime.now().isoformat(timespec="seconds")),
        )
    con.close()


def consolidate_pipeline_entry(source: str, task_tag: str, text: str,
                               day: str | None = None,
                               timestamp: str | None = None,
                               details: list[str] | None = None,
                               session_id: str | None = None,
                               context: str | None = None,
                               origin: str | None = None) -> None:
    """One live entry per pipeline task: replace all rows carrying the tag
    (tagged column, or legacy tag-in-text) with one block, earliest ts kept."""
    if not source or not task_tag or not text:
        return
    headline = " ".join(text.split())
    if task_tag not in headline:
        headline = f"{task_tag} — {headline}"
    d = day or datetime.now().strftime("%Y-%m-%d")
    d, _ = _clamp_future(d, "00:00")   # day first — the tag match below runs on it
    agent, submode = parse_source(source)

    con = connect()
    with con:
        matched = con.execute(
            "SELECT id, time FROM entries WHERE date = ? AND"
            " (pipeline_task = ? OR headline LIKE ? OR details LIKE ?)",
            (d, task_tag, f"%{task_tag}%", f"%{task_tag}%"),
        ).fetchall()
        earliest = min((t for _, t in matched), default=None)
        if matched:
            con.executemany("DELETE FROM entries WHERE id = ?",
                            [(i,) for i, _ in matched])
        final_ts = timestamp or earliest or datetime.now().strftime("%H:%M")
        _, final_ts = _clamp_future(d, final_ts)
        con.execute(
            "INSERT INTO entries (date, time, agent, submode, headline, details,"
            " pipeline_task, session_id, context, origin, created_at)"
            " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
            (d, final_ts, agent, submode, headline,
             json.dumps(_clean_details(details), ensure_ascii=False),
             task_tag, session_id, (context or "").strip(),
             origin or default_origin(),
             datetime.now().isoformat(timespec="seconds")),
        )
    con.close()


def set_verdict(seat: str, verdict: str, note: str) -> str | None:
    """Stamp the seat's latest entry. Returns the stamped headline, or None."""
    agent, submode = parse_source(seat)
    con = connect()
    with con:
        where = "agent = ?" + (" AND submode = ?" if submode else "")
        params: tuple = (agent, submode) if submode else (agent,)
        row = con.execute(
            f"SELECT id, headline FROM entries WHERE {where}"
            " ORDER BY date DESC, time DESC, id DESC LIMIT 1", params,
        ).fetchone()
        if row is None:
            return None
        con.execute("UPDATE entries SET verdict = ?, verdict_note = ? WHERE id = ?",
                    (verdict, note, row[0]))
    con.close()
    return row[1]


# -------------------------------------------------------------------- queries

def tail_entries(seat: str, n: int, origin: str | None = None) -> list[dict]:
    """Last n entries for a seat, oldest→newest. Bare agent = all submodes.

    Seats are directories: a seat query matches its own dir plus every
    ancestor dir (social/chat also pulls social), never siblings — a chat
    seat's tail can't pick up a neighboring work dir's lineage. It also
    matches the agent's submode-less rows — entries migrated from the
    pre-seat era (and any bare-source writes). Broader rows age out of the
    last-n window as seat-tagged entries accrue; without this, every seat
    would boot blind right after migration.

    origin='direct' keeps only human-driven entries (auto/cron rows are
    origin='indirect'; pre-origin legacy '' rows count as direct). This is
    the injection view — a person sitting down reads the seat's worked
    narrative, not the auto flood's publish log."""
    agent, submode = parse_source(seat)
    con = connect()
    if submode:
        lineage = [submode]
        while "/" in lineage[-1]:
            lineage.append(lineage[-1].rsplit("/", 1)[0])
        lineage.append("")
        marks = ",".join("?" * len(lineage))
        where = f"agent = ? AND submode IN ({marks})"
        params: tuple = (agent, *lineage)
    else:
        where = "agent = ?"
        params = (agent,)
    if origin == "direct":
        where += " AND origin != 'indirect'"
    rows = con.execute(
        f"SELECT id, date, time, agent, submode, headline, details, verdict,"
        f" verdict_note, session_id, context, origin FROM entries WHERE {where}"
        " ORDER BY date DESC, time DESC, id DESC LIMIT ?", params + (n,),
    ).fetchall()
    con.close()
    out = []
    for eid, date, ts, a, s, h, dt, v, vn, sid, ctx, org in reversed(rows):
        out.append({
            "id": eid, "date": date, "time": ts, "agent": a, "submode": s,
            "headline": h, "details": json.loads(dt),
            "verdict": v, "verdict_note": vn,
            "session_id": sid, "context": ctx, "origin": org,
        })
    return out


def format_tail(entries: list[dict]) -> str:
    """Default tail text — what seat injection boots on. Lean by design:
    headline + bullets + verdict only; `context` never rides (on-demand via
    --json or `show`)."""
    lines = []
    for e in entries:
        lines.append(f"{e['date']} {e['time']} — {e['headline']}")
        for d in e["details"]:
            lines.append(f"- {d}")
        if e["verdict"]:
            note = f" — {e['verdict_note']}" if e["verdict_note"] else ""
            lines.append(f"  ↳ verdict: {e['verdict']}{note}")
    return "\n".join(lines)


def grep_entries(pattern: str, seat: str | None = None,
                 since: str | None = None) -> list[dict]:
    """Substring search (case-insensitive) over headline + details + context,
    across all days and seats — the recall surface for 'when did we do X?'."""
    esc = (pattern.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_"))
    like = f"%{esc}%"
    where = ["(headline LIKE ? ESCAPE '\\' OR details LIKE ? ESCAPE '\\'"
             " OR context LIKE ? ESCAPE '\\')"]
    params: list = [like, like, like]
    if seat:
        agent, submode = parse_source(seat)
        where.append("agent = ?"); params.append(agent)
        if submode:
            where.append("submode = ?"); params.append(submode)
    if since:
        where.append("date >= ?"); params.append(since)
    con = connect()
    rows = con.execute(
        "SELECT id, date, time, agent, submode, headline, origin FROM entries"
        f" WHERE {' AND '.join(where)} ORDER BY date, time, id", params,
    ).fetchall()
    con.close()
    return [{"id": i, "date": d, "time": t, "source": format_source(a, s),
             "headline": h, "origin": o} for i, d, t, a, s, h, o in rows]


def recall_entries(day_from: str, day_to: str,
                   seat: str | None = None) -> list[dict]:
    """A day (or range) replayed — the recall surface for date questions
    ('what happened Monday?'), optionally narrowed to one seat. Same store,
    same seat semantics as tail (bare agent = all its seats)."""
    where = ["date >= ?", "date <= ?"]
    params: list = [day_from, day_to]
    if seat:
        agent, submode = parse_source(seat)
        where.append("agent = ?"); params.append(agent)
        if submode:
            where.append("submode IN (?, '')"); params.append(submode)
    con = connect()
    rows = con.execute(
        "SELECT id, date, time, agent, submode, headline, details, verdict,"
        " verdict_note, session_id, context, origin FROM entries"
        f" WHERE {' AND '.join(where)} ORDER BY date, time, id", params,
    ).fetchall()
    con.close()
    out = []
    for i, d, t, a, s, h, dt, v, vn, sid, ctx, org in rows:
        out.append({"id": i, "date": d, "time": t,
                    "source": format_source(a, s), "headline": h,
                    "details": json.loads(dt), "verdict": v,
                    "verdict_note": vn, "session_id": sid, "context": ctx,
                    "origin": org})
    return out


def format_recall(entries: list[dict], full: bool = False) -> str:
    """Block-shaped replay plus what tail never shows: ids, seat verdicts,
    and (with full) each entry's context."""
    blocks = []
    for e in entries:
        lines = [f"#{e['id']} {e['date']} {e['time']} [{e['source']}]",
                 e["headline"]]
        for d in e["details"]:
            lines.append(f"- {d}")
        if e["verdict"]:
            note = f" — {e['verdict_note']}" if e["verdict_note"] else ""
            lines.append(f"  ↳ verdict: {e['verdict']}{note}")
        if full and e["context"]:
            lines.append(f"context:\n{e['context']}")
        blocks.append("\n".join(lines))
    return "\n\n".join(blocks)


def show_entry(entry_id: int) -> dict | None:
    """Everything one entry holds — the on-demand loader behind a grep/tail hit."""
    con = connect()
    row = con.execute(
        "SELECT id, date, time, agent, submode, headline, details,"
        " pipeline_task, session_id, verdict, verdict_note, context, origin"
        " FROM entries WHERE id = ?", (entry_id,),
    ).fetchone()
    con.close()
    if row is None:
        return None
    i, d, t, a, s, h, dt, pt, sid, v, vn, ctx, org = row
    return {"id": i, "date": d, "time": t, "source": format_source(a, s),
            "headline": h, "details": json.loads(dt), "pipeline_task": pt,
            "session_id": sid, "verdict": v, "verdict_note": vn,
            "context": ctx, "origin": org}


# ------------------------------------------------------------------------ CLI

def _write_usage() -> str:
    return ('usage: log_event <agent[/submode]> "<headline>" [--at HH:MM] '
            '[--date YYYY-MM-DD] [--detail "..."]... [--context "..."] '
            '[--origin direct|indirect] [--pipeline-task <tag>] [--session <id>]\n'
            '       (--at/--date default to now/today, machine-local — omit '
            'unless logging an earlier event;\n'
            '        --origin defaults from $JSTACK_TIMELINE_ORIGIN, else direct)\n'
            '   or: log_event tail <agent[/submode]> [-n N] [--json]\n'
            '   or: log_event grep "<substring>" [--seat <agent[/submode]>] '
            '[--since YYYY-MM-DD] [--json]\n'
            '   or: log_event recall <YYYY-MM-DD[..YYYY-MM-DD]> '
            '[<agent[/submode]>|all] [--full] [--json]\n'
            '   or: log_event show <id>\n'
            '   or: log_event verdict <agent[/submode]> '
            '<shipped|drift|blocked|empty> --note "..."')


def _cmd_tail(rest: list[str]) -> int:
    seat, n, as_json, origin = None, 10, False, None
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "-n":
            n = int(rest[i + 1]); i += 2
        elif a == "--json":
            as_json = True; i += 1
        elif a == "--origin":
            origin = rest[i + 1]; i += 2
            if origin != "direct":
                print("log_event tail: --origin accepts only 'direct' "
                      "(the human-driven view; omit for all origins)",
                      file=sys.stderr)
                return 2
        elif a.startswith("-"):
            print(f"log_event tail: unknown flag {a}", file=sys.stderr)
            return 2
        elif seat is not None:
            print(f"log_event tail: one seat only (got {seat!r} and {a!r})",
                  file=sys.stderr)
            return 2
        else:
            seat = a; i += 1
    if not seat:
        print("log_event tail: seat required (agent or agent/submode)", file=sys.stderr)
        return 2
    entries = tail_entries(seat, n, origin=origin)
    if as_json:
        print(json.dumps(entries, ensure_ascii=False, indent=2))
    elif entries:
        print(format_tail(entries))
    return 0


def _cmd_grep(rest: list[str]) -> int:
    pattern, seat, since, as_json = None, None, None, False
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--seat":
            seat = rest[i + 1]; i += 2
        elif a == "--since":
            since = rest[i + 1]; i += 2
        elif a == "--json":
            as_json = True; i += 1
        elif a.startswith("-"):
            print(f"log_event grep: unknown flag {a}", file=sys.stderr)
            return 2
        elif pattern is not None:
            print(f"log_event grep: one pattern only (got {pattern!r} and {a!r})"
                  " — quote multi-word patterns", file=sys.stderr)
            return 2
        else:
            pattern = a; i += 1
    if not pattern:
        print('log_event grep: pattern required', file=sys.stderr)
        return 2
    hits = grep_entries(pattern, seat=seat, since=since)
    if as_json:
        print(json.dumps(hits, ensure_ascii=False, indent=2))
    else:
        for h in hits:
            print(f"#{h['id']} {h['date']} {h['time']} [{h['source']}] {h['headline']}")
    return 0 if hits else 1


def _cmd_recall(rest: list[str]) -> int:
    dates, seat, full, as_json = None, None, False, False
    pos: list[str] = []
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--full":
            full = True; i += 1
        elif a == "--json":
            as_json = True; i += 1
        elif a.startswith("-"):
            print(f"log_event recall: unknown flag {a}", file=sys.stderr)
            return 2
        else:
            pos.append(a); i += 1
    if len(pos) > 2:
        print(f"log_event recall: too many arguments: {' '.join(pos[2:])}",
              file=sys.stderr)
        return 2
    if pos:
        dates = pos[0]
    if len(pos) >= 2 and pos[1] != "all":
        seat = pos[1]
    if not dates:
        print("log_event recall: date required (YYYY-MM-DD or "
              "YYYY-MM-DD..YYYY-MM-DD)", file=sys.stderr)
        return 2
    day_from, _, day_to = dates.partition("..")
    day_to = day_to or day_from
    if not (re.fullmatch(r"\d{4}-\d{2}-\d{2}", day_from)
            and re.fullmatch(r"\d{4}-\d{2}-\d{2}", day_to)):
        print(f"log_event recall: bad date '{dates}' (expected YYYY-MM-DD or "
              "YYYY-MM-DD..YYYY-MM-DD)", file=sys.stderr)
        return 2
    entries = recall_entries(day_from, day_to, seat=seat)
    if as_json:
        print(json.dumps(entries, ensure_ascii=False, indent=2))
    elif entries:
        print(format_recall(entries, full=full))
    return 0 if entries else 1


def _cmd_show(rest: list[str]) -> int:
    try:
        entry_id = int(rest[0])
    except (IndexError, ValueError):
        print("log_event show: numeric entry id required (from grep/tail --json)",
              file=sys.stderr)
        return 2
    e = show_entry(entry_id)
    if e is None:
        print(f"log_event show: no entry #{entry_id}", file=sys.stderr)
        return 1
    print(f"#{e['id']} {e['date']} {e['time']} [{e['source']}]")
    print(e["headline"])
    for d in e["details"]:
        print(f"- {d}")
    if e["pipeline_task"]:
        print(f"pipeline-task: {e['pipeline_task']}")
    if e["session_id"]:
        print(f"session: {e['session_id']}")
    if e["origin"]:
        print(f"origin: {e['origin']}")
    if e["verdict"]:
        note = f" — {e['verdict_note']}" if e["verdict_note"] else ""
        print(f"↳ verdict: {e['verdict']}{note}")
    if e["context"]:
        print(f"context:\n{e['context']}")
    return 0


def _cmd_verdict(rest: list[str]) -> int:
    note = ""
    pos: list[str] = []
    i = 0
    while i < len(rest):
        if rest[i] == "--note":
            note = rest[i + 1]; i += 2
        else:
            pos.append(rest[i]); i += 1
    if len(pos) != 2 or pos[1] not in _VALID_VERDICTS:
        print(f"log_event verdict: need <agent[/submode]> <{'|'.join(sorted(_VALID_VERDICTS))}> --note",
              file=sys.stderr)
        return 2
    stamped = set_verdict(pos[0], pos[1], note)
    if stamped is None:
        print(f"log_event verdict: no entries for {pos[0]}", file=sys.stderr)
        return 1
    print(f"verdict[{pos[1]}] → {pos[0]}: {stamped[:80]}")
    return 0


def main(argv: list[str]) -> int:
    if not argv:
        print(_write_usage(), file=sys.stderr)
        return 2

    if argv[0] in _SUBCOMMANDS:
        cmd, rest = argv[0], argv[1:]
        if cmd == "tail":
            return _cmd_tail(rest)
        if cmd == "grep":
            return _cmd_grep(rest)
        if cmd == "recall":
            return _cmd_recall(rest)
        if cmd == "show":
            return _cmd_show(rest)
        if cmd == "verdict":
            return _cmd_verdict(rest)

    if len(argv) < 2:
        print(_write_usage(), file=sys.stderr)
        return 2

    source = argv[0]
    rest = argv[1:]
    seat_err = _seat_error(source, rest)
    if seat_err:
        print(seat_err, file=sys.stderr)
        return 2
    timestamp = day = pipeline_task = session_id = context = origin = None
    details: list[str] = []
    words: list[str] = []

    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--at":
            timestamp = rest[i + 1]; i += 2
        elif a == "--date":
            day = rest[i + 1]; i += 2
        elif a == "--pipeline-task":
            pipeline_task = rest[i + 1]; i += 2
        elif a == "--detail":
            details.append(rest[i + 1]); i += 2
        elif a == "--context":
            context = rest[i + 1]; i += 2
        elif a == "--session":
            session_id = rest[i + 1]; i += 2
        elif a == "--origin":
            origin = rest[i + 1]; i += 2
        elif a.startswith("-") and len(a) > 1:
            print(f"log_event: unknown flag {a} — supported: --at --date "
                  "--detail --context --origin --pipeline-task --session",
                  file=sys.stderr)
            return 2
        else:
            words.append(a); i += 1

    text = " ".join(words)
    if timestamp and not re.fullmatch(r"\d{2}:\d{2}", timestamp):
        print(f"log_event: bad --at '{timestamp}' (expected HH:MM)", file=sys.stderr)
        return 2
    if day and not re.fullmatch(r"\d{4}-\d{2}-\d{2}", day):
        print(f"log_event: bad --date '{day}' (expected YYYY-MM-DD)", file=sys.stderr)
        return 2
    if origin and origin not in _VALID_ORIGINS:
        print(f"log_event: bad --origin '{origin}' (expected direct|indirect)",
              file=sys.stderr)
        return 2

    label = day if day else "today"
    if pipeline_task:
        consolidate_pipeline_entry(source, pipeline_task, text, day=day,
                                   timestamp=timestamp, details=details,
                                   session_id=session_id, context=context,
                                   origin=origin)
        print(f"consolidated: {source} ({label}) [{pipeline_task}] {text[:80]}")
    else:
        append_timeline(source, text, day=day, timestamp=timestamp,
                        details=details, session_id=session_id, context=context,
                        origin=origin)
        print(f"logged: {source} ({label}) {text[:80]}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
