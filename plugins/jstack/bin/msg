#!/usr/bin/env python3
"""msg — agent-to-agent messaging in exactly two forms.

    msg send @seat "content"           an UPDATE: news, no reply expected
    msg send @seat "content" --wake    a TASK: they act now and answer
    msg reply <id> "content"           the answer to a task

    msg inbox / read <id> / thread <id> / sent      reading

An **update** is a note. It shows up once in the receiver's next session as
context and is done — it obliges nobody, closes itself, and never comes back.

A **task** is a request you cannot do yourself, and `--wake` is what makes it
one: the receiver is reached now — typed into their live session, or a session
is spawned for it — they do it, and they reply. The answer comes back to you.
It is a subagent call to another agent, and it lives and dies inside that one
exchange.

Nothing accumulates. A task binds ONLY the session it was delivered to, so
opening a chat can never make an agent go off doing something that has been
sitting around; an unanswered task is the sender's problem to notice, visible
in `msg sent`, and it is invisible to every other session.

The bar for a task is that it genuinely needs them — their access, their
device, context you cannot get. Work you could do yourself is not a task
because a doc names someone else as the owner, and a message is never sent to
correct or withdraw an earlier message.

Addressing — `@agent` is the agent's cockpit, hyphens walk down to a sub-seat:

    @mario                 -> mario/chat
    @lynda-social          -> lynda/social/chat   (descends into chat/)
    @lynda-pm              -> lynda/pm            (no pm/chat dir)
    @jarvis-service-call   -> jarvis/service-call
    @self                  -> the sender's own seat

The trailing descent into `chat/` is the rule that makes `@lynda-social` mean
the social OPERATOR seat rather than the social container — the same
`{base}-social-chat` convention the rest of the stack already uses.

Store: the timeline db ({timeline_dir}/timeline.db), own `messages` table.
One store, one backup, one WAL; the timeline's `entries` table is untouched.
This binary is the only sanctioned writer of `messages` — a second writer
would fork the source of truth (same law log_event holds).

`@boss` is deliberately NOT a mailbox: the host's own Boss channel owns human
contact and already has a reply path. Sending to it errors and says so.

Self-contained python3 stdlib — no venv, no host imports. Safe to call from
hooks, crons, spawned sessions, or interactively.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import sqlite3
import subprocess
import sys
from datetime import datetime, timedelta
from pathlib import Path

def _is_seat(path: Path) -> bool:
    """A seat is a directory holding a CLAUDE.md — the same evidence the
    injector and review engine use to recognize one.

    This is the gate, not a blocklist of storage dir names: `Junior/ideas`
    is a real seat and `Mario/pad` is not, and only the file on disk knows
    which is which. Addressing a dir no session ever boots in would file a
    message that could never be read — so it must fail at send time."""
    return (path / "CLAUDE.md").is_file()


def _seats_under(root: Path) -> list:
    try:
        return sorted(c.name for c in root.iterdir()
                      if c.is_dir() and not c.name.startswith(".") and _is_seat(c))
    except OSError:
        return []

_SCHEMA = """
CREATE TABLE IF NOT EXISTS messages (
    id             INTEGER PRIMARY KEY AUTOINCREMENT,
    created_at     TEXT NOT NULL,
    from_seat      TEXT NOT NULL,
    to_agent       TEXT NOT NULL,
    to_seat        TEXT NOT NULL,
    subject        TEXT NOT NULL,
    body           TEXT NOT NULL DEFAULT '',
    attachments    TEXT NOT NULL DEFAULT '[]',
    wake           INTEGER NOT NULL DEFAULT 0,
    reply_to       INTEGER,
    thread_id      INTEGER NOT NULL DEFAULT 0,
    -- update | seen | task | answered
    state          TEXT NOT NULL DEFAULT 'update',
    resolution     TEXT,
    resolved_at    TEXT,
    resolved_by    TEXT,
    origin_session TEXT,
    -- The session a task was handed to. A task binds to this one session and
    -- no other, which is what makes a stale item impossible.
    bound_session  TEXT,
    delivery       TEXT NOT NULL DEFAULT ''
);
CREATE INDEX IF NOT EXISTS idx_messages_to ON messages(to_seat, state, created_at);
CREATE INDEX IF NOT EXISTS idx_messages_agent ON messages(to_agent, state, created_at);
CREATE INDEX IF NOT EXISTS idx_messages_thread ON messages(thread_id, created_at);
"""


# --------------------------------------------------------------- config/store


def _config() -> dict:
    """Host config — shared with the timeline/review engine."""
    path = Path(os.environ.get(
        "JSTACK_REVIEW_CONFIG",
        str(Path.home() / ".claude" / "jstack" / "review.json"),
    )).expanduser()
    try:
        data = json.loads(path.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError, ValueError):
        return {}


def _mail_config() -> dict:
    cfg = _config().get("mail")
    return cfg if isinstance(cfg, dict) else {}


def timeline_dir() -> Path:
    env = os.environ.get("JSTACK_TIMELINE_DIR", "").strip()
    if env:
        return Path(env).expanduser()
    return Path.home() / "Logs" / "Timeline"


def db_path() -> Path:
    root = timeline_dir()
    root.mkdir(parents=True, exist_ok=True)
    return root / "timeline.db"


def connect() -> sqlite3.Connection:
    con = sqlite3.connect(db_path(), timeout=10)
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("PRAGMA busy_timeout=5000")
    con.executescript(_SCHEMA)
    cols = {r[1] for r in con.execute("PRAGMA table_info(messages)")}
    if "bound_session" not in cols:
        con.execute("ALTER TABLE messages ADD COLUMN bound_session TEXT")
        con.commit()
    for dead in ("deferred_until", "deferred_session"):
        if dead in cols:
            try:
                con.execute(f"ALTER TABLE messages DROP COLUMN {dead}")
                con.commit()
            except sqlite3.Error:
                pass
    con.row_factory = sqlite3.Row
    return con


def session_id() -> str:
    """The calling session, or '' when there is none."""
    return os.environ.get("CLAUDE_CODE_SESSION_ID") or ""


def agent_root() -> Path:
    return Path(_config().get("agent_root") or "~/Agents").expanduser()


def now_iso() -> str:
    return datetime.now().isoformat(timespec="seconds")


def _fail(msg: str, code: int = 2) -> "None":
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


# ------------------------------------------------------------------ addressing


def _agent_dirs() -> dict:
    """lowercase agent name -> its workspace dir. Filesystem is the truth:
    an agent is a directory under the agent root holding a CLAUDE.md — the
    same gate the SessionStart injector and the review engine use."""
    out = {}
    try:
        for child in sorted(agent_root().iterdir()):
            if child.is_dir() and (child / "CLAUDE.md").is_file():
                out[child.name.lower()] = child
    except OSError:
        pass
    return out


def _walk_segments(root: Path, segs: list) -> "str|None":
    """Resolve hyphen segments as a directory path under root.

    'service-call' resolves as the single dir `service-call` before it is
    tried as `service/call`: a hyphen inside a real directory name is far
    commoner than a nested pair, and trying the whole string first is what
    makes @jarvis-service-call work without special-casing it."""
    if not segs:
        return ""
    whole = "-".join(segs)
    if _is_seat(root / whole):
        return whole
    for i in range(1, len(segs)):
        head = "-".join(segs[:i])
        sub = root / head
        if not sub.is_dir():
            continue
        tail = _walk_segments(sub, segs[i:])
        if tail is not None:
            return f"{head}/{tail}" if tail else head
    return None


def resolve_seat(spec: str, sender: "str|None" = None) -> tuple:
    """'@lynda-social' -> ('lynda', 'social/chat', Path(...)).

    Raises SystemExit with a usable message when the seat is not a real dir —
    a message addressed to nowhere must fail loudly at send time, never land
    in a table nobody reads."""
    spec = (spec or "").strip()
    if spec.startswith("@"):
        spec = spec[1:]
    if not spec:
        _fail("no recipient — use @agent, @agent-seat, or @self")
    if spec.lower() in ("self", "me"):
        if not sender:
            _fail("@self: could not resolve the sending seat from cwd")
        agent, _, submode = sender.partition("/")
        return agent, (submode or "chat"), (agent_root() / agent) / (submode or "chat")
    if spec.lower() == "boss":
        _fail("@boss is not a mailbox — the host's Boss channel owns human "
              "contact and has its own reply path. Use it instead.")

    agents = _agent_dirs()
    parts = [p for p in spec.lower().split("-") if p]
    base = None
    root = None
    # Longest agent-name match first: an agent whose own name holds a hyphen
    # must win over the same prefix read as agent + seat.
    for i in range(len(parts), 0, -1):
        cand = "-".join(parts[:i])
        if cand in agents:
            base, root, parts = cand, agents[cand], parts[i:]
            break
    if base is None:
        known = ", ".join(sorted(agents)) or "(none found)"
        _fail(f"unknown agent in {spec!r}. Known agents: {known}")

    submode = _walk_segments(root, parts)
    if submode is None:
        _fail(f"{spec!r}: no seat {'-'.join(parts)!r} under {root}. "
              f"Seats there: {', '.join(_seats_under(root)) or '(none)'}")

    # The cockpit descent: a seat that itself holds a chat/ dir means the
    # operator seat, not the container. @lynda-social -> lynda/social/chat.
    if not submode:
        submode = "chat" if _is_seat(root / "chat") else ""
    elif _is_seat(root / submode / "chat"):
        submode = f"{submode}/chat"

    if not submode:
        _fail(f"{spec!r}: {root} has no chat/ seat to address")
    seat_dir = root / submode
    if not _is_seat(seat_dir):
        _fail(f"{spec!r}: {seat_dir} is not a seat (no CLAUDE.md) — no session "
              f"boots there, so a message would never be read. "
              f"Seats: {', '.join(_seats_under(root)) or '(none)'}")
    return base, submode, seat_dir


def _seat_of(path: "Path|None") -> "str|None":
    """A directory -> the seat it sits in, or None. The injector's resolution."""
    if path is None:
        return None
    root = agent_root()
    try:
        rel = path.resolve().relative_to(root.resolve())
    except (ValueError, OSError):
        return None
    if not rel.parts or not (root / rel.parts[0] / "CLAUDE.md").is_file():
        return None
    submode = "/".join(p.lower() for p in rel.parts[1:]) or "chat"
    return f"{rel.parts[0].lower()}/{submode}"


def _session_cwd() -> "Path|None":
    """The calling session's own workspace, read from its transcript.

    cwd is where the agent last `cd`'d to, which is routinely somewhere else —
    a repo, an infra dir. The transcript records the workspace the session was
    started in, so a message sent or closed from anywhere still carries the
    seat that did it, rather than an anonymous '?'."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "").strip()
    if not sid:
        return None
    try:
        hits = sorted((Path.home() / ".claude" / "projects").glob(f"*/{sid}.jsonl"))
    except OSError:
        return None
    for path in hits:
        try:
            with path.open() as fh:
                for _ in range(40):
                    line = fh.readline()
                    if not line:
                        break
                    cwd = (json.loads(line) or {}).get("cwd")
                    if cwd:
                        return Path(cwd)
        except (OSError, json.JSONDecodeError, ValueError, AttributeError):
            continue
    return None


def sender_seat() -> "str|None":
    """The calling session's seat: an override, then cwd, then its workspace."""
    env = os.environ.get("JSTACK_MAIL_FROM", "").strip()
    if env:
        return env
    return _seat_of(Path.cwd()) or _seat_of(_session_cwd())


# ---------------------------------------------------------------- attachments


def _stash_attachments(paths: list, seat_dir: Path, agent_dir: "Path|None" = None) -> list:
    """Copy each file into the receiving seat's pad and return the new paths.

    The receiver must be able to open an attachment after the sender's own
    scratch is gone, so the bytes move to the receiver's side at send time.
    Same landing convention the share-sheet drop already uses: a stamped
    name in a pad the receiving agent owns.

    A file already **anywhere under the receiving agent's own tree** is
    recorded where it lies. The copy exists to make the file reachable by the
    receiver; one that is already inside their tree is already reachable, and
    copying it would leave two files and no fact about which is real. This is
    the share-sheet path: a drop lands in the agent's pad before any message
    is written."""
    if not paths:
        return []
    pad = seat_dir / "pad"
    try:
        pad.mkdir(parents=True, exist_ok=True)
    except OSError:
        pad = seat_dir
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    out = []
    for p in paths:
        src = Path(p).expanduser()
        if not src.is_file():
            _fail(f"--file {p}: no such file")
        try:
            rs = src.resolve()
            inside = rs.parent == pad.resolve()
            if not inside and agent_dir is not None:
                inside = agent_dir.resolve() in rs.parents
            if inside:
                out.append(str(rs))
                continue
        except OSError:
            pass
        dest = pad / f"{stamp}-{src.name}"
        n = 1
        while dest.exists():
            n += 1
            dest = pad / f"{stamp}-{n}-{src.name}"
        try:
            shutil.copy2(src, dest)
        except OSError as e:
            _fail(f"--file {p}: {e}")
        out.append(str(dest))
    return out


# -------------------------------------------------------------------- display


def _short(row, width: int = 78) -> str:
    subj = row["subject"]
    if len(subj) > width:
        subj = subj[:width - 1] + "…"
    return subj


def _row_header(row) -> str:
    bits = [f"[#{row['id']}]", f"from {row['from_seat']}", row["created_at"].replace("T", " ")]
    bits.append({"task": "TASK — unanswered", "answered": "task, answered"}
                .get(row["state"], "update"))
    if row["reply_to"]:
        bits.append(f"reply to #{row['reply_to']}")
    return " · ".join(bits)


def _render(row, full: bool = False) -> str:
    lines = [_row_header(row), f"  {_short(row)}"]
    if full:
        if row["body"]:
            lines.append("")
            lines.extend("  " + ln for ln in row["body"].splitlines())
        atts = json.loads(row["attachments"] or "[]")
        if atts:
            lines.append("")
            lines.append("  Attachments:")
            lines.extend(f"    {a}" for a in atts)
        if row["state"] == "answered":
            lines.append("")
            lines.append(f"  ✓ answered {(row['resolved_at'] or '').replace('T', ' ')}"
                         f" by {row['resolved_by'] or '?'}")
            if row["resolution"]:
                lines.extend("    " + ln for ln in row["resolution"].splitlines())
    return "\n".join(lines)


def _dump(rows, as_json: bool, full: bool = False) -> None:
    if as_json:
        print(json.dumps([dict(r) for r in rows], indent=2))
        return
    if not rows:
        print("(nothing)")
        return
    print("\n\n".join(_render(r, full=full) for r in rows))


# ------------------------------------------------------------------- delivery


#: How far back an unseen update is still news. Older than this it is not
#: shown to anyone — a note nobody read for a week is not worth a session's
#: attention, and silently ageing out is the only thing that guarantees the
#: mailbox cannot grow into a backlog.
UPDATE_TTL_DAYS = 7
UPDATE_MAX = 8


def unseen_updates(con, seat: str) -> list:
    """Updates this seat has not been shown yet, newest first, capped and aged.

    Reading them marks them seen — an update is delivered exactly once."""
    cutoff = (datetime.now() - timedelta(days=UPDATE_TTL_DAYS)).isoformat(timespec="seconds")
    return con.execute(
        "SELECT * FROM messages WHERE to_seat = ? AND state = 'update' "
        "AND created_at >= ? ORDER BY created_at DESC, id DESC LIMIT ?",
        (seat, cutoff, UPDATE_MAX)).fetchall()


def mark_seen(con, rows) -> None:
    ids = [r["id"] for r in rows]
    if not ids:
        return
    con.execute(f"UPDATE messages SET state='seen' WHERE id IN "
                f"({','.join('?' * len(ids))})", ids)
    con.commit()


def tasks_for_session(con, sid: str) -> list:
    """Unanswered tasks handed to THIS session — never any other.

    The whole no-backlog guarantee is this one clause: a task nobody delivered
    to you is not yours to discover, so no session can ever be ambushed by
    something that has been sitting around."""
    if not sid:
        return []
    return con.execute(
        "SELECT * FROM messages WHERE state = 'task' AND bound_session = ? "
        "ORDER BY created_at, id", (sid,)).fetchall()


def _wake_prompt(row) -> str:
    atts = json.loads(row["attachments"] or "[]")
    parts = [
        f"[inbox:{row['id']}] Task from {row['from_seat']}. They are waiting on "
        f"your answer — do it now, then reply.",
        "",
        row["subject"],
    ]
    if row["body"]:
        parts += ["", row["body"]]
    if atts:
        parts += ["", "Attachments:"] + [f"  {a}" for a in atts]
    parts += [
        "",
        f'  msg reply {row["id"]} "what you did, or the answer they asked for"',
        "",
        "That reply is the whole point of this task and it goes straight back "
        "to them. Nothing else is expected of you: this is the only thing in "
        "your inbox, and when you have answered it there is nothing left.",
    ]
    return "\n".join(parts)


# There was a rung above the wake once: a host hook (`mail.deliver_live`) that
# found a live session of the seat and typed the task into it, to save the
# minute the wake costs and reuse a session whose context was already warm.
# It is gone, and the reason is worth keeping.
#
# Mail addresses a SEAT, and a seat is a chat dir — that is the rule that stops
# mail to a cockpit from hijacking cron workers. So every target the live rung
# could ever resolve was a conversation, and the session it picked was the
# most recently active one, which is by construction the one a person is
# typing in. It was not a delivery path that occasionally hit a human; it was
# aimed at them. On 2026-08-27 it appended a task to a half-written question of
# Boss's, submitted the two as one message, and sent the session off to answer
# the sender instead of him. Across its whole life it delivered exactly once,
# and that was the once.
#
# A task now books the wake and nothing else. The wake is headless by design —
# a fresh `claude --print` in the seat's workspace — so it disturbs no live
# session, and costs about a minute.


def seat_dir_for(seat: str) -> "Path|None":
    """'mario/chat' -> its workspace dir, or None if it is no longer a seat.

    The stored seat string is the identity; a wake has to be booked against a
    directory. A seat that has since been renamed away returns None rather
    than a path nothing boots in."""
    agent, _, submode = (seat or "").partition("/")
    root = _agent_dirs().get(agent.lower())
    if root is None or not submode:
        return None
    d = root / submode
    return d if _is_seat(d) else None


def _book_wake(seat: str, seat_dir: Path, row, at: "str|None" = None) -> "str|None":
    """Book a one-shot on the host scheduler — the wake. Default: one minute out.

    Not a new spawn path: the scheduler already owns 'run claude in this
    workspace with this context message, with a timeout, a model tier and a
    journal entry', and the wake lands on the schedule page like any other."""
    mail = _mail_config()
    if mail.get("wake") is False:
        return None
    plugin_root = Path(__file__).resolve().parent.parent
    env = os.environ.copy()
    env["PYTHONPATH"] = f"{plugin_root}:{env.get('PYTHONPATH', '')}".rstrip(":")
    home = mail.get("scheduler_home")
    if home:
        env["SCHEDULER_HOME"] = str(Path(home).expanduser())
    python = str(Path(mail.get("python") or sys.executable or "python3").expanduser())

    at = at or (datetime.now() + timedelta(minutes=1)).strftime("%Y-%m-%d %H:%M")
    agent_id = seat.replace("/", "-")
    argv = [
        python, "-m", "scheduler.cli", "add-once",
        "--agent", agent_id,
        "--at", at,
        "--workspace", str(seat_dir),
        "--message", _wake_prompt(row),
        "--name", f"inbox #{row['id']} → {seat}",
        "--category", mail.get("category") or "inbox",
        "--delete-after-run",
    ]
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=30,
                           env=env, cwd=str(plugin_root))
    except (OSError, subprocess.SubprocessError) as e:
        print(f"warning: wake could not be booked ({e})", file=sys.stderr)
        return None
    if r.returncode != 0:
        detail = (r.stderr or r.stdout or "").strip().splitlines()
        print(f"warning: wake could not be booked "
              f"({detail[-1] if detail else 'scheduler refused'})", file=sys.stderr)
        return None
    return f"spawned:{at}"


# ------------------------------------------------------------------- commands


def cmd_send(args) -> int:
    con = connect()
    frm = args.frm or sender_seat()
    if not frm:
        _fail("could not resolve the sending seat from cwd — pass --from agent/seat")
    agent, submode, seat_dir = resolve_seat(args.to, sender=frm)
    seat = f"{agent}/{submode}"

    content = (args.content or "").strip()
    if not content:
        _fail("empty message")
    subject, _, body = content.partition("\n")
    subject = subject.strip()[:200] or content[:200]
    body = body.strip()

    reply_to = args.reply_to
    thread_id = 0
    if reply_to:
        parent = con.execute("SELECT * FROM messages WHERE id = ?", (reply_to,)).fetchone()
        if not parent:
            _fail(f"--reply-to {reply_to}: no such message")
        thread_id = parent["thread_id"] or parent["id"]

    # The agent's own root — seat_dir climbed back up past every submode part.
    agent_dir = seat_dir
    for _ in submode.split("/"):
        agent_dir = agent_dir.parent
    atts = _stash_attachments(args.file or [], seat_dir, agent_dir)
    state = "task" if args.wake else "update"
    cur = con.execute(
        "INSERT INTO messages (created_at, from_seat, to_agent, to_seat, subject, "
        "body, attachments, wake, reply_to, thread_id, state, origin_session) "
        "VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
        (now_iso(), frm, agent, seat, subject, body, json.dumps(atts),
         1 if args.wake else 0, reply_to, thread_id, state,
         os.environ.get("CLAUDE_CODE_SESSION_ID") or None))
    mid = cur.lastrowid
    if not thread_id:
        con.execute("UPDATE messages SET thread_id = ? WHERE id = ?", (mid, mid))
    con.commit()

    if not args.wake:
        print(f"#{mid} → {seat} — update, lands in their next session")
        return 0

    # A task gets its own session — a headless wake, about a minute out — and
    # binds to it. It is never typed into a session someone is already in: see
    # the note above `seat_dir_for`. A task that reaches nobody is not filed to
    # be found later; it is reported failed, because the sender is the one
    # waiting.
    row = con.execute("SELECT * FROM messages WHERE id = ?", (mid,)).fetchone()
    delivery = _book_wake(seat, seat_dir, row) or ""
    bound = f"wake:{mid}" if delivery else None
    if not delivery:
        con.execute("DELETE FROM messages WHERE id = ?", (mid,))
        con.commit()
        _fail(f"could not reach {seat} — no wake could be booked. "
              f"Nothing was filed: a task nobody is doing is not a message, and "
              f"leaving it to be found later is the backlog this refuses to make.",
              code=3)
    con.execute("UPDATE messages SET delivery = ?, bound_session = ? WHERE id = ?",
                (delivery, bound, mid))
    con.commit()
    print(f"#{mid} → {seat} — session spawning at "
          f"{delivery.split(':', 1)[1]} PT; their reply comes back to you")
    return 0


def cmd_reply(args) -> int:
    """Answer a task. The answer closes it — there is no separate close."""
    con = connect()
    parent = con.execute("SELECT * FROM messages WHERE id = ?", (args.id,)).fetchone()
    if not parent:
        _fail(f"no message #{args.id}")
    me = args.frm or sender_seat()
    content = (args.content or "").strip()
    if parent["state"] == "task":
        con.execute(
            "UPDATE messages SET state='answered', resolution=?, resolved_at=?, "
            "resolved_by=? WHERE id = ?", (content, now_iso(), me or "?", args.id))
        con.commit()
    args.to = "@" + parent["from_seat"].replace("/", "-")
    args.reply_to = args.id
    args.frm = me
    return cmd_send(args)


def cmd_inbox(args) -> int:
    """Recent traffic for a seat — a report, never a work queue.

    Reading an inbox does not make anything yours. A task is yours only when
    it was handed to your session; everything else here is news."""
    con = connect()
    cutoff = (datetime.now() - timedelta(days=UPDATE_TTL_DAYS)).isoformat(timespec="seconds")
    where, params = "created_at >= ?", [cutoff]
    if args.agent:
        where += " AND to_agent = ?"
        params.append(args.agent.lstrip("@").lower())
    elif not args.all:
        seat = args.seat or sender_seat()
        if not seat:
            _fail("not in an agent seat — pass --seat agent/seat, --agent NAME, or --all")
        where += " AND to_seat = ?"
        params.append(seat)
    rows = con.execute(f"SELECT * FROM messages WHERE {where} AND state <> 'answered' "
                       f"ORDER BY created_at, id", params).fetchall()
    if not args.json and rows:
        tasks = sum(1 for r in rows if r["state"] == "task")
        note = f"{len(rows)} in the last {UPDATE_TTL_DAYS} days"
        print(f"{note} — {tasks} unanswered task(s), the rest are notes.\n"
              if tasks else f"{note}, all notes — nothing is waiting on anyone.\n")
    _dump(rows, args.json)
    return 0


def cmd_read(args) -> int:
    con = connect()
    row = con.execute("SELECT * FROM messages WHERE id = ?", (args.id,)).fetchone()
    if not row:
        _fail(f"no message #{args.id}")
    if args.json:
        print(json.dumps(dict(row), indent=2))
        return 0
    print(_render(row, full=True))
    sibs = con.execute(
        "SELECT COUNT(*) c FROM messages WHERE thread_id = ?", (row["thread_id"],)).fetchone()
    if sibs and sibs["c"] > 1:
        print(f"\n  ({sibs['c']} in this thread — msg thread {row['thread_id']})")
    return 0


def cmd_thread(args) -> int:
    con = connect()
    row = con.execute("SELECT * FROM messages WHERE id = ?", (args.id,)).fetchone()
    if not row:
        _fail(f"no message #{args.id}")
    rows = con.execute("SELECT * FROM messages WHERE thread_id = ? ORDER BY created_at, id",
                       (row["thread_id"],)).fetchall()
    _dump(rows, args.json, full=True)
    return 0


def cmd_sent(args) -> int:
    con = connect()
    frm = args.frm or sender_seat()
    if not frm:
        _fail("not in an agent seat — pass --from agent/seat")
    rows = con.execute(
        "SELECT * FROM messages WHERE from_seat = ? ORDER BY created_at DESC, id DESC "
        "LIMIT ?", (frm, args.n)).fetchall()
    _dump(list(reversed(rows)), args.json, full=True)
    return 0


def cmd_pending(args) -> int:
    """Hook helper: unanswered tasks handed to THIS session. Exit 1 = none.

    Two ways a task is "handed to" a session: typed into a live one (which
    records its id), or spawned for it (the run's prompt carries the id, and
    `--woken` is how the hook passes that along). Nothing else qualifies."""
    con = connect()
    rows = list(tasks_for_session(con, args.session or session_id()))
    if args.woken and not any(str(r["id"]) == str(args.woken) for r in rows):
        extra = con.execute("SELECT * FROM messages WHERE id = ? AND state = 'task'",
                            (args.woken,)).fetchone()
        if extra:
            rows.append(extra)
    print(json.dumps([dict(r) for r in rows]))
    return 0 if rows else 1


def cmd_updates(args) -> int:
    """Hook helper: this seat's unseen updates, then mark them seen.

    Delivered exactly once. `--peek` reads without consuming, so a failed
    injection does not silently eat the news."""
    con = connect()
    rows = unseen_updates(con, args.seat)
    print(json.dumps([dict(r) for r in rows]))
    if rows and not args.peek:
        mark_seen(con, rows)
    return 0 if rows else 1


# ---------------------------------------------------------------------- parse


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="msg", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    def _send_flags(sp):
        sp.add_argument("--wake", action="store_true",
                        help="the receiver acts now: type into a live session, else spawn one")
        sp.add_argument("--file", action="append", metavar="PATH",
                        help="attach a file (copied into the receiver's pad)")
        sp.add_argument("--from", dest="frm", metavar="SEAT",
                        help="sending seat (default: inferred from cwd)")

    s = sub.add_parser("send", help="send a message to a seat")
    s.add_argument("to", metavar="@agent[-seat]")
    s.add_argument("content")
    s.add_argument("--reply-to", type=int, metavar="ID")
    _send_flags(s)
    s.set_defaults(func=cmd_send)

    r = sub.add_parser("reply", help="answer a message in its thread")
    r.add_argument("id", type=int)
    r.add_argument("content")
    _send_flags(r)
    r.set_defaults(func=cmd_reply)

    i = sub.add_parser("inbox", help="open items for this seat")
    i.add_argument("--seat", metavar="agent/seat")
    i.add_argument("--agent", metavar="NAME", help="every seat of one agent")
    i.add_argument("--all", action="store_true", help="every seat, every agent")
    i.add_argument("--json", action="store_true")
    i.set_defaults(func=cmd_inbox)

    rd = sub.add_parser("read", help="one message in full")
    rd.add_argument("id", type=int)
    rd.add_argument("--json", action="store_true")
    rd.set_defaults(func=cmd_read)

    t = sub.add_parser("thread", help="the whole conversation")
    t.add_argument("id", type=int)
    t.add_argument("--json", action="store_true")
    t.set_defaults(func=cmd_thread)

    st = sub.add_parser("sent", help="what this seat sent, and what came of it")
    st.add_argument("-n", type=int, default=10)
    st.add_argument("--from", dest="frm", metavar="SEAT")
    st.add_argument("--json", action="store_true")
    st.set_defaults(func=cmd_sent)

    pd = sub.add_parser("pending-for", help="hook helper: this session's unanswered tasks")
    pd.add_argument("seat", nargs="?", default="")
    pd.add_argument("--session", metavar="SID", default="",
                    help="the asking session — a task binds to one session only")
    pd.add_argument("--woken", metavar="ID", default="",
                    help="the task this session was spawned for")
    pd.set_defaults(func=cmd_pending)

    up = sub.add_parser("updates-for", help="hook helper: a seat's unseen updates (consumes them)")
    up.add_argument("seat")
    up.add_argument("--peek", action="store_true", help="read without marking seen")
    up.set_defaults(func=cmd_updates)

    return p


def main() -> int:
    args = build_parser().parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
